<Project>
  <!-- Versões fixadas (RNF014). Atualizações devem ser registradas em documentation/DEPENDENCIAS.md -->
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="FFmpeg.AutoGen" Version="9.0.1.1" />
    <PackageVersion Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageVersion Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <!-- Bibliotecas nativas por sistema (MedPlataforma, Directory.Build.props). O OpenCvSharp não publica runtime
         para macOS: no macOS o OpenCvSharpExtern precisa ser compilado (ver documentation/DEPENDENCIAS.md). -->
    <PackageVersion Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageVersion Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.13.0.20260627" />
    <PackageVersion Include="Svg.Skia" Version="5.2.3" />
    <!-- Biblioteca nativa do SkiaSharp para Linux; mesma versão do SkiaSharp que o Svg.Skia usa. -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.148.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI.DirectML" Version="0.14.1" />
    <!-- Linux e macOS: mesmas versões sem DirectML (CPU; CoreML no macOS). -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.14.1" />
    <PackageVersion Include="Whisper.net" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- Instalador (WiX 6, installer\) -->
    <PackageVersion Include="WixToolset.UI.wixext" Version="6.0.2" />
    <PackageVersion Include="WixToolset.Util.wixext" Version="6.0.2" />
    <PackageVersion Include="WixToolset.BootstrapperApplications.wixext" Version="6.0.2" />
    <!-- Testes -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
</Project>
