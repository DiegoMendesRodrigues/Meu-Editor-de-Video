<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NetArchTest.Rules" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Imagens de referência de textos e formas (RasterReferenceTests). -->
    <None Include="Text\Referencias\*" CopyToOutputDirectory="PreserveNewest" LinkBase="Text\Referencias" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MeuEditorDeVideo.Presentation\MeuEditorDeVideo.Presentation.csproj" />
    <!-- O aplicativo entra nas regras de camadas e de privacidade (assembly MeuEditorDeVideo). -->
    <ProjectReference Include="..\..\src\MeuEditorDeVideo.Desktop\MeuEditorDeVideo.Desktop.csproj" />
  </ItemGroup>
  <!-- Modelo de IA incluído no aplicativo (MODNet), como na saída do App (VisionTests, AiDeviceTests). -->
  <PropertyGroup>
    <BuiltInModelsDir>$(MSBuildThisFileDirectory)..\..\deps\ai-models\</BuiltInModelsDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(BuiltInModelsDir)')">
    <None Include="..\..\resources\ai-models\incluidos\**\*" Link="ai-models\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(BuiltInModelsDir)**\*.onnx" Link="ai-models\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
