<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Testes da interface Avalonia sem tela (Avalonia.Headless com desenho Skia real): rodam em Windows, Linux e macOS.
    Também geram capturas das janelas em TestResults/telas/ para conferir a conversão do WPF.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="NetArchTest.Rules" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MeuEditorDeVideo.Desktop\MeuEditorDeVideo.Desktop.csproj" />
  </ItemGroup>
</Project>
