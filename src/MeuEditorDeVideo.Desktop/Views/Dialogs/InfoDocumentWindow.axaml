<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MeuEditorDeVideo.Desktop.Views.Dialogs.InfoDocumentWindow"
        Width="760"
        Height="640"
        MinWidth="480"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="True"
        Background="{DynamicResource Med.WindowBackground}"
        Foreground="{DynamicResource Med.Text}">
    <!-- Atalhos de teclado e Informações do sistema (menu Ajuda). -->
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="Status" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource Med.TextMuted}" />
            <Button DockPanel.Dock="Right" Content="Fechar" IsCancel="True" IsDefault="True" Click="Fechar_Click" Padding="18,4" Margin="8,0,0,0" />
            <Button x:Name="Copiar" DockPanel.Dock="Right" Content="Copiar" Click="Copiar_Click" Padding="18,4" IsVisible="False"
                    AutomationProperties.Name="Copiar para a área de transferência" />
        </DockPanel>
        <ScrollViewer x:Name="Visualizador" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource Med.Background}" />
    </DockPanel>
</Window>
