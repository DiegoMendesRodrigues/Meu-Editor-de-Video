<!-- Desenvolvido por Diego Mendes Rodrigues - https://www.linkedin.com/in/diegomendesrodrigues/ -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:MeuEditorDeVideo.Desktop.Controls"
        xmlns:vm="using:MeuEditorDeVideo.Presentation.ViewModels.Timeline"
        x:Class="MeuEditorDeVideo.Desktop.Views.Dialogs.MixerWindow"
        x:DataType="vm:MixerViewModel"
        Title="Mixer de áudio"
        Width="640"
        Height="440"
        MinWidth="300"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AutomationProperties.Name="Mixer de áudio"
        Background="{DynamicResource Med.WindowBackground}"
        Foreground="{DynamicResource Med.Text}">
    <!-- Mixer (RF130): um canal por trilha de áudio — medidor, fader, panorâmica, mudo e solo — e o total (master). -->
    <Window.Styles>
        <Style Selector="TextBlock.mx-small">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Med.TextMuted}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.mx-toggle">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Med.TextMuted}"
                   Text="M silencia a trilha; S (solo) faz só as trilhas em solo soarem. Duplo clique no fader ou na panorâmica volta ao padrão. Os medidores se movem durante a reprodução." />

        <!-- Total -->
        <Border DockPanel.Dock="Right" Width="96" Margin="12,0,0,0" Padding="8" CornerRadius="6" Background="{DynamicResource Med.PanelAlt}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Total" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock DockPanel.Dock="Bottom" Classes="mx-small" Margin="0,6,0,0">
                    <Run Text="Monitor " /><Run Text="{Binding Preview.Volume, StringFormat=0, Mode=OneWay}" /><Run Text="%" />
                </TextBlock>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding MasterPeak}" Classes="mx-small" Margin="0,4,0,0"
                           AutomationProperties.AutomationId="PicoTotal" />
                <Grid HorizontalAlignment="Center" ColumnDefinitions="10,3,10,10,Auto">
                    <ctl:LevelMeter Grid.Column="0" Level="{Binding MasterL}" AutomationProperties.Name="Nível total esquerdo" />
                    <ctl:LevelMeter Grid.Column="2" Level="{Binding MasterR}" AutomationProperties.Name="Nível total direito" />
                    <Slider Grid.Column="4" Orientation="Vertical" Minimum="0" Maximum="100" Value="{Binding Preview.Volume}"
                            AutomationProperties.Name="Volume do monitor" ToolTip.Tip="Volume do monitor (não afeta a exportação)" />
                </Grid>
            </DockPanel>
        </Border>

        <Grid>
            <TextBlock Text="Não há trilhas de áudio. Adicione uma trilha de áudio na linha do tempo." TextWrapping="Wrap"
                       Foreground="{DynamicResource Med.TextMuted}" Margin="4" IsVisible="{Binding !HasTracks}" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Strips}" AutomationProperties.Name="Canais do mixer">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MixerStripViewModel">
                            <Border Width="104" Margin="0,0,8,0" Padding="8" CornerRadius="6" Background="{DynamicResource Med.PanelAlt}"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Canal {0}'}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center" ToolTip.Tip="{Binding Name}" Margin="0,0,0,6" />
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <ToggleButton Content="M" Classes="mx-toggle" IsChecked="{Binding IsMuted}"
                                                      ToolTip.Tip="Silenciar trilha" AutomationProperties.Name="{Binding Name, StringFormat='Silenciar {0}'}" />
                                        <ToggleButton Content="S" Classes="mx-toggle" IsChecked="{Binding IsSolo}"
                                                      ToolTip.Tip="Solo: ouvir só as trilhas em solo" AutomationProperties.Name="{Binding Name, StringFormat='Solo {0}'}" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                        <Slider Minimum="-100" Maximum="100" Value="{Binding Pan}" SmallChange="5" LargeChange="20"
                                                ToolTip.Tip="Panorâmica (esquerda/direita)"
                                                AutomationProperties.Name="{Binding Name, StringFormat='Panorâmica {0}'}"
                                                DoubleTapped="OnPanDoubleTapped" />
                                        <TextBlock Text="{Binding PanDisplay}" Classes="mx-small" />
                                        <TextBlock Text="{Binding VolumeDisplay}" Classes="mx-small" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Grid HorizontalAlignment="Center" ColumnDefinitions="9,3,9,10,Auto">
                                        <ctl:LevelMeter Grid.Column="0" Level="{Binding LevelL}" />
                                        <ctl:LevelMeter Grid.Column="2" Level="{Binding LevelR}" />
                                        <Slider Grid.Column="4" Orientation="Vertical" Minimum="-60" Maximum="12" Value="{Binding VolumeDb}"
                                                SmallChange="0.5" LargeChange="3" ToolTip.Tip="Volume da trilha (dB)"
                                                AutomationProperties.Name="{Binding Name, StringFormat='Volume {0}'}"
                                                DoubleTapped="OnVolumeDoubleTapped" />
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
