<!-- Desenvolvido por Diego Mendes Rodrigues - https://www.linkedin.com/in/diegomendesrodrigues/ -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MeuEditorDeVideo.Presentation.ViewModels"
        x:Class="MeuEditorDeVideo.Desktop.Views.Dialogs.NewProjectWindow"
        x:DataType="vm:NewProjectViewModel"
        Title="Novo projeto"
        Width="560"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Med.WindowBackground}"
        Foreground="{DynamicResource Med.Text}">
    <Window.Resources>
        <!-- Linha de um modelo de projeto na lista e na caixa fechada. -->
        <DataTemplate x:Key="ModeloLinha" x:DataType="vm:ProjectTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Label}" />
                <TextBlock Text="{Binding Description}" Classes="med-muted" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="Auto,Auto">
        <StackPanel Grid.Row="0" Margin="16">

            <!-- 1. Modelo de projeto: itens agrupados (geral, internet e redes sociais, personalizado) montados no código. -->
            <TextBlock Text="Modelo de projeto" Margin="0,0,0,4" />
            <ComboBox x:Name="ModeloCombo" AutomationProperties.Name="Modelo de projeto" MaxDropDownHeight="460"
                      HorizontalAlignment="Stretch" Margin="0,0,0,12" />

            <!-- 2. Nome do projeto -->
            <TextBlock Text="Nome do projeto" Margin="0,0,0,4" />
            <TextBox x:Name="NameTextBox" Text="{Binding Name}" AutomationProperties.Name="Nome do projeto" Padding="6,4" Margin="0,0,0,12" />

            <!-- 3. Pasta -->
            <TextBlock Text="Pasta" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding Directory}" AutomationProperties.Name="Pasta do projeto" Padding="6,4" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="Procurar…" Command="{Binding BrowseDirectoryCommand}" AutomationProperties.Name="Procurar pasta"
                        Margin="8,0,0,0" Padding="12,4" />
            </Grid>
            <TextBlock Classes="med-muted" TextWrapping="Wrap" Margin="0,0,0,12">
                <Run Text="Arquivo: " /><Run Text="{Binding TargetPath, Mode=OneWay}" />
            </TextBlock>

            <!-- 4. Proporção e resolução -->
            <Grid Margin="0,0,0,12" ColumnDefinitions="*,16,*">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Proporção" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Aspects}" SelectedItem="{Binding SelectedAspect, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="Proporção" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Resolução" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding SelectedAspect.Resolutions}" SelectedItem="{Binding SelectedResolution, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="Resolução" />
                </StackPanel>
            </Grid>

            <!-- 5. Resolução personalizada -->
            <Grid Margin="0,0,0,12" ColumnDefinitions="*,16,*" IsVisible="{Binding IsCustomResolution}">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Largura" Margin="0,0,0,4" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding CustomWidth}" AutomationProperties.Name="Largura personalizada em pixels" Padding="6,4" />
                        <TextBlock Grid.Column="1" Text="px" Classes="med-muted" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Altura" Margin="0,0,0,4" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding CustomHeight}" AutomationProperties.Name="Altura personalizada em pixels" Padding="6,4" />
                        <TextBlock Grid.Column="1" Text="px" Classes="med-muted" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- 6. FPS e perfil de cores -->
            <Grid Margin="0,0,0,12" ColumnDefinitions="*,16,*">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="FPS" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding FrameRates}" SelectedItem="{Binding SelectedFrameRate, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="Quadros por segundo" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Perfil de cores" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding ColorProfiles}" SelectedItem="{Binding SelectedColorProfile, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="Perfil de cores" />
                </StackPanel>
            </Grid>

            <!-- 7. Armazenamento das mídias -->
            <TextBlock Text="Armazenamento das mídias" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding StorageModes}" SelectedItem="{Binding SelectedStorageMode, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Armazenamento das mídias" Margin="0,0,0,12" />

            <!-- 8. Validação -->
            <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource Med.Danger}" TextWrapping="Wrap" Margin="0,0,0,4"
                       IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <!-- 9. Botões -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Med.Border}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancelar" AutomationProperties.Name="Cancelar" Command="{Binding CancelCommand}" IsCancel="True" Padding="16,8" />
                <Button Content="Criar projeto" AutomationProperties.Name="Criar projeto" Classes="med-accent" Command="{Binding CreateCommand}"
                        IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
