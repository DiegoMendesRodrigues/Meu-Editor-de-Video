<UserControl x:Class="MeuEditorDeVideo.Desktop.Views.Panels.ClipVideoPanel"
             Classes="inspetor"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ins="using:MeuEditorDeVideo.Presentation.ViewModels.Inspector"
             x:DataType="ins:ClipInspectorViewModel">
    <!-- Aba "Vídeo" do painel C: transformação, keyframes, recorte, mistura, velocidade, congelar/repetir, transição (F6). -->
    <Grid>
        <TextBlock Text="Selecione um clipe de vídeo ou imagem na linha do tempo para editar transformação, keyframes, velocidade e transições."
                   TextWrapping="Wrap" Margin="12" Classes="med-muted" IsVisible="{Binding !HasClip}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,4,10,10"
                      IsVisible="{Binding HasClip}">
            <StackPanel>
                <TextBlock Text="{Binding ClipTitle}" FontWeight="SemiBold" Foreground="{DynamicResource Med.Text}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />

                <!-- Transformação e animação -->
                <DockPanel Margin="0,14,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="&#xE892;" Classes="ins-icon" Command="{Binding PreviousKeyframeCommand}"
                                ToolTip.Tip="Keyframe anterior" AutomationProperties.Name="Keyframe anterior" />
                        <Button Content="&#xE893;" Classes="ins-icon" Command="{Binding NextKeyframeCommand}"
                                ToolTip.Tip="Próximo keyframe" AutomationProperties.Name="Próximo keyframe" />
                    </StackPanel>
                    <TextBlock Text="Transformação" Classes="ins-section" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Animated}" />
                <TextBlock Classes="ins-label" TextWrapping="Wrap" Margin="0,2,0,6"
                           Text="◇ cria um keyframe no instante do cursor; com keyframes, alterar o valor grava um novo keyframe." />
                <Grid ColumnDefinitions="80,*" Margin="0,0,0,6" IsVisible="{Binding IsAnyAnimated}">
                    <TextBlock Text="Interpolação" Classes="ins-label" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Easings}" SelectedItem="{Binding SelectedEasing}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Interpolação do keyframe" ToolTip.Tip="Curva do keyframe no cursor (ou do anterior) até o próximo" />
                </Grid>
                <WrapPanel>
                    <Button Content="Girar 90° ↺" Classes="ins-small" Command="{Binding RotateLeftCommand}" AutomationProperties.Name="Girar 90 graus à esquerda" />
                    <Button Content="Girar 90° ↻" Classes="ins-small" Command="{Binding RotateRightCommand}" AutomationProperties.Name="Girar 90 graus à direita" />
                    <Button Content="Preencher quadro" Classes="ins-small" Command="{Binding FillFrameCommand}" AutomationProperties.Name="Preencher quadro" />
                    <Button Content="Redefinir" Classes="ins-small" Command="{Binding ResetTransformCommand}" AutomationProperties.Name="Redefinir transformação" />
                </WrapPanel>
                <WrapPanel Margin="0,2,0,0">
                    <CheckBox Content="Espelhar horizontalmente" IsChecked="{Binding FlipHorizontal}" Margin="0,0,12,4" AutomationProperties.Name="Espelhar horizontalmente" />
                    <CheckBox Content="Espelhar verticalmente" IsChecked="{Binding FlipVertical}" Margin="0,0,0,4" AutomationProperties.Name="Espelhar verticalmente" />
                </WrapPanel>

                <TextBlock Text="Animações prontas" Classes="ins-section" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <ComboBox ItemsSource="{Binding AnimationPresetOptions}" SelectedItem="{Binding SelectedAnimationPreset}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Animação pronta" ToolTip.Tip="{Binding SelectedAnimationPreset.Value.Description}" />
                    <Button Grid.Column="1" Content="Aplicar" Classes="ins-small" Margin="6,0,0,0"
                            Command="{Binding ApplyAnimationPresetCommand}" AutomationProperties.Name="Aplicar animação pronta" />
                </Grid>

                <TextBlock Text="3D (perspectiva)" Classes="ins-section" />
                <ItemsControl ItemsSource="{Binding Animated3D}" />
                <WrapPanel>
                    <Button Content="Virar cartão 3D" Classes="ins-small" Command="{Binding ApplyCardFlipCommand}"
                            AutomationProperties.Name="Virar cartão 3D" ToolTip.Tip="Entrada girando como um cartão (keyframes de Giro Y)" />
                </WrapPanel>

                <TextBlock Text="Recorte" Classes="ins-section" />
                <ItemsControl ItemsSource="{Binding Crop}" />
                <Button Content="Aplicar recorte ao vídeo" Classes="ins-small" Command="{Binding ApplyCropCommand}" HorizontalAlignment="Left"
                        Margin="0,2,0,6" AutomationProperties.Name="Aplicar recorte ao vídeo"
                        ToolTip.Tip="Muda o tamanho do projeto para o da área recortada (em pixels da mídia original). A exportação sai com essas dimensões." />

                <TextBlock Text="Composição" Classes="ins-section" />
                <Grid ColumnDefinitions="92,*" Margin="0,0,0,6">
                    <TextBlock Text="Mistura" Classes="ins-label" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding BlendModes}" SelectedItem="{Binding SelectedBlendMode}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Modo de mistura" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Fades}" />

                <TextBlock Text="Velocidade" Classes="ins-section" />
                <Grid ColumnDefinitions="92,*,Auto" Margin="0,0,0,6">
                    <TextBlock Text="{Binding SpeedText, StringFormat='Atual: {0}'}" Classes="ins-label" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SpeedPresets}" SelectedItem="{Binding SelectedSpeed}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Velocidade predefinida" />
                    <Button Grid.Column="2" Content="Outra…" Classes="ins-small" Margin="6,0,0,0" Command="{Binding CustomSpeedCommand}"
                            AutomationProperties.Name="Outra velocidade" />
                </Grid>
                <CheckBox Content="{StaticResource Editor.Clipe.AoContrario}" IsChecked="{Binding ReverseClip}" Margin="0,0,0,6"
                          AutomationProperties.Name="Reproduzir ao contrário" ToolTip.Tip="{StaticResource Editor.Clipe.AoContrario.Dica}" />
                <CheckBox Content="Câmera lenta suavizada (mistura de quadros)" IsChecked="{Binding FrameBlending}" Margin="0,0,0,6"
                          AutomationProperties.Name="Câmera lenta suavizada" ToolTip.Tip="Abaixo de 1×, mistura quadros vizinhos para reduzir os saltos" />
                <CheckBox Content="{StaticResource Editor.Clipe.Interpolacao}" IsChecked="{Binding OpticalFlow}" Margin="0,0,0,6"
                          AutomationProperties.Name="Interpolação de quadros" ToolTip.Tip="{StaticResource Editor.Clipe.Interpolacao.Dica}" />
                <Grid ColumnDefinitions="92,*" Margin="0,0,0,6">
                    <TextBlock Text="{StaticResource Editor.Clipe.CurvaVelocidade}" Classes="ins-label" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SpeedRampOptions}" SelectedItem="{Binding SelectedSpeedRamp}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Curva de velocidade" ToolTip.Tip="{StaticResource Editor.Clipe.CurvaVelocidade.Dica}" />
                </Grid>
                <Grid ColumnDefinitions="92,*,40" Margin="0,0,0,8">
                    <TextBlock Text="{StaticResource Editor.Clipe.DesfoqueMovimento}" Classes="ins-label" TextWrapping="Wrap" />
                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MotionBlur}" VerticalAlignment="Center"
                            AutomationProperties.Name="Desfoque de movimento" ToolTip.Tip="{StaticResource Editor.Clipe.DesfoqueMovimento.Dica}" />
                    <TextBlock Grid.Column="2" Text="{Binding MotionBlur, StringFormat='{}{0:0} %'}" Classes="ins-label" HorizontalAlignment="Right" />
                </Grid>
                <WrapPanel>
                    <Button Content="Congelar quadro" Classes="ins-small" Command="{Binding FreezeFrameCommand}"
                            AutomationProperties.Name="Congelar quadro" ToolTip.Tip="Insere o quadro do cursor parado por alguns segundos" />
                    <Button Content="Repetir trecho" Classes="ins-small" Command="{Binding RepeatClipCommand}"
                            AutomationProperties.Name="Repetir trecho" ToolTip.Tip="Repete o clipe logo depois dele" />
                </WrapPanel>
                <TextBlock Text="Este clipe é um quadro congelado." Classes="ins-label" IsVisible="{Binding IsFrozen}" />

                <TextBlock Text="Transição de entrada" Classes="ins-section" />
                <StackPanel>
                    <ComboBox ItemsSource="{Binding TransitionOptions}" SelectedItem="{Binding SelectedTransition}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Transição de entrada" Margin="0,0,0,6" />
                    <Grid ColumnDefinitions="92,*,56">
                        <TextBlock Text="Duração" Classes="ins-label" />
                        <Slider Grid.Column="1" Minimum="0.1" Maximum="{Binding TransitionMaxSeconds}" Value="{Binding TransitionSeconds}"
                                SmallChange="0.1" LargeChange="0.5" AutomationProperties.Name="Duração da transição" />
                        <TextBlock Grid.Column="2" Text="{Binding TransitionDisplay}" Classes="ins-label" TextAlignment="Right" />
                    </Grid>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Classes="ins-label" IsVisible="{Binding !HasTransitionSlot}"
                           Text="Sem clipe encostado antes deste, a transição é de entrada: revela o clipe sobre as trilhas de baixo." />

                <!-- Rastreamento de câmera: câmera virtual que acompanha a cabeça ou o corpo (efeito de IA) -->
                <TextBlock Text="Rastreamento de câmera" Classes="ins-section" />
                <TextBlock Classes="ins-label" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Escolha o que a câmera acompanha. Depois ajuste o corte automático, o agitar e o fundo desfocado. Usa o modelo de recorte de pessoa (aba IA)." />
                <UniformGrid Columns="2" Margin="0,0,0,6">
                    <Button Classes="ins-card" Command="{Binding StartCameraTrackingCommand}" CommandParameter="0"
                            AutomationProperties.Name="Rastrear a cabeça" ToolTip.Tip="A câmera acompanha a cabeça da pessoa">
                        <StackPanel>
                            <Border Classes="ins-thumb" Height="46">
                                <TextBlock Classes="med-icon" Text="&#xE77B;" FontSize="22"
                                           Foreground="{DynamicResource Med.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Cabeça" Classes="ins-card-text" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ins-card" Command="{Binding StartCameraTrackingCommand}" CommandParameter="1"
                            AutomationProperties.Name="Rastrear o corpo" ToolTip.Tip="A câmera acompanha o corpo inteiro da pessoa">
                        <StackPanel>
                            <Border Classes="ins-thumb" Height="46">
                                <TextBlock Classes="med-icon" Text="&#xE716;" FontSize="22"
                                           Foreground="{DynamicResource Med.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Corpo" Classes="ins-card-text" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
                <ContentControl Content="{Binding CameraTracking}" Focusable="False" />

                <!-- Retocar: beleza e maquiagem sobre os pontos do rosto (efeitos de IA, modelo Face Mesh) -->
                <TextBlock Text="Retocar" Classes="ins-section" />
                <TextBlock Classes="ins-label" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Beleza (pele, rosto, olhos, nariz, boca e sobrancelhas) e maquiagem virtual. Usa o modelo de pontos do rosto (aba IA › Modelos › Face Mesh V2)." />
                <UniformGrid Columns="2" Margin="0,0,0,6">
                    <Button Classes="ins-card" Command="{Binding StartRetouchCommand}" CommandParameter="beauty"
                            AutomationProperties.Name="Retocar: beleza" ToolTip.Tip="Pele suave, menos linhas e bolsas; ajustes de rosto, olhos, nariz, boca e sobrancelhas">
                        <StackPanel>
                            <Border Classes="ins-thumb" Height="46">
                                <TextBlock Classes="med-icon" Text="&#xE76E;" FontSize="22"
                                           Foreground="{DynamicResource Med.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Beleza" Classes="ins-card-text" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ins-card" Command="{Binding StartRetouchCommand}" CommandParameter="makeup"
                            AutomationProperties.Name="Retocar: maquiagem" ToolTip.Tip="Looks prontos, cílios, sombra, delineador, sobrancelhas, batom, blush, contorno, realces, cor dos olhos e sardas">
                        <StackPanel>
                            <Border Classes="ins-thumb" Height="46">
                                <TextBlock Classes="med-icon" Text="&#xE771;" FontSize="22"
                                           Foreground="{DynamicResource Med.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Maquiagem" Classes="ins-card-text" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ins-card" Command="{Binding StartRetouchCommand}" CommandParameter="faceblur"
                            AutomationProperties.Name="Desfocar rostos" ToolTip.Tip="{StaticResource Editor.Clipe.DesfocarRostos.Dica}">
                        <StackPanel>
                            <Border Classes="ins-thumb" Height="46">
                                <TextBlock Classes="med-icon" Text="&#xE72E;" FontSize="22"
                                           Foreground="{DynamicResource Med.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Desfocar rostos" Classes="ins-card-text" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
                <ContentControl Content="{Binding Beauty}" Focusable="False" />
                <ContentControl Content="{Binding Makeup}" Focusable="False" />
                <ContentControl Content="{Binding FaceBlurEffect}" Focusable="False" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
