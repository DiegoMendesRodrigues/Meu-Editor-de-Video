<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Estilos compartilhados. Baseados nos estilos Fluent nativos (BasedOn tipo). -->

    <!-- Botões desabilitados ficam visivelmente esmaecidos (o Fluent escuro diferencia pouco) -->
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Med.PanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Med.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Med.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="Med.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Med.Text}" />
    </Style>

    <Style x:Key="Med.MutedText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Med.TextMuted}" />
    </Style>

    <Style x:Key="Med.AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Med.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Botão de barra de ferramentas: ícone (Segoe Fluent Icons) + texto opcional -->
    <Style x:Key="Med.ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="2,0" />
    </Style>

    <Style x:Key="Med.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
