<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MeuEditorDeVideo</AssemblyName>
    <RootNamespace>MeuEditorDeVideo.App</RootNamespace>
    <ApplicationIcon>Assets\icone.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\**\*.png" />
  </ItemGroup>
  <!-- Bibliotecas nativas do FFmpeg (baixadas por scripts\fetch-deps.ps1) copiadas para a pasta ffmpeg\ do aplicativo. -->
  <PropertyGroup>
    <FFmpegBinDir>$(MSBuildThisFileDirectory)..\..\deps\ffmpeg\bin\</FFmpegBinDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(FFmpegBinDir)')">
    <None Include="$(FFmpegBinDir)*.dll" Link="ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <!-- Modelos de IA incluídos no aplicativo (MODNet): manifesto, licença e documentação do repositório + arquivo do modelo
       baixado por scripts\fetch-deps.ps1 (SHA-256 no lock), copiados para a pasta ai-models\ do aplicativo. -->
  <PropertyGroup>
    <BuiltInModelsDir>$(MSBuildThisFileDirectory)..\..\deps\ai-models\</BuiltInModelsDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(BuiltInModelsDir)')">
    <None Include="..\..\resources\ai-models\incluidos\**\*" Link="ai-models\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(BuiltInModelsDir)**\*.onnx" Link="ai-models\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <!-- Catálogo oficial de modelos (endereços fixos, SHA-256, recursos, dependências) e licenças, para a ferramenta
       "Baixar modelos" gerar os pacotes .medmodel. -->
  <ItemGroup>
    <None Include="..\..\resources\ai-models\modelos.json" Link="catalogo-ia\modelos.json" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\resources\ai-models\licencas\*.txt" Link="catalogo-ia\licencas\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\resources\templates\export\*.json" Link="templates\export\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MeuEditorDeVideo.Application\MeuEditorDeVideo.Application.csproj" />
    <ProjectReference Include="..\MeuEditorDeVideo.Infrastructure\MeuEditorDeVideo.Infrastructure.csproj" />
    <ProjectReference Include="..\MeuEditorDeVideo.ProjectEngine\MeuEditorDeVideo.ProjectEngine.csproj" />
    <ProjectReference Include="..\MeuEditorDeVideo.MediaEngine\MeuEditorDeVideo.MediaEngine.csproj" />
    <ProjectReference Include="..\MeuEditorDeVideo.TimelineEngine\MeuEditorDeVideo.TimelineEngine.csproj" />
    <ProjectReference Include="..\MeuEditorDeVideo.ImageEngine\MeuEditorDeVideo.ImageEngine.csproj" />
    <ProjectReference Include="..\MeuEditorDeVideo.AudioEngine\MeuEditorDeVideo.AudioEngine.csproj" />
    <ProjectReference Include="..\MeuEditorDeVideo.AIEngine\MeuEditorDeVideo.AIEngine.csproj" />
    <ProjectReference Include="..\MeuEditorDeVideo.RenderingEngine\MeuEditorDeVideo.RenderingEngine.csproj" />
    <ProjectReference Include="..\MeuEditorDeVideo.ModelDownloads\MeuEditorDeVideo.ModelDownloads.csproj" />
  </ItemGroup>
</Project>
