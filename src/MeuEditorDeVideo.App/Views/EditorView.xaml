<UserControl x:Class="MeuEditorDeVideo.App.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MeuEditorDeVideo.App.ViewModels"
             xmlns:media="clr-namespace:MeuEditorDeVideo.App.ViewModels.Media"
             xmlns:tl="clr-namespace:MeuEditorDeVideo.App.ViewModels.Timeline"
             xmlns:ctl="clr-namespace:MeuEditorDeVideo.App.Controls"
             xmlns:vw="clr-namespace:MeuEditorDeVideo.App.Views"
             xmlns:panels="clr-namespace:MeuEditorDeVideo.App.Views.Panels"
             xmlns:model="clr-namespace:MeuEditorDeVideo.Domain.Model;assembly=MeuEditorDeVideo.Domain"
             Background="{DynamicResource Med.Background}"
             Foreground="{DynamicResource Med.Text}"
             FontSize="12">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Editor.BoolToVis" />
        <!-- Linha de informação: rótulo à esquerda, valor à direita -->
        <DataTemplate x:Key="Editor.LinhaInfo">
            <Grid Margin="0,0,0,10" ToolTip="{Binding Value}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Med.MutedText}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource Med.Text}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
        <!-- Painéis do editor: retos e colados, separados por 1 px do fundo -->
        <Style x:Key="Editor.Painel" TargetType="Border" BasedOn="{StaticResource Med.PanelBorder}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <!-- Botões da barra de ações e de controles -->
        <Style x:Key="Editor.Acao" TargetType="Button" BasedOn="{StaticResource Med.ToolbarButton}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="Editor.Controle" TargetType="Button" BasedOn="{StaticResource Med.ToolbarButton}">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <Style x:Key="Editor.Icone" TargetType="TextBlock" BasedOn="{StaticResource Med.Icon}">
            <Setter Property="FontSize" Value="14" />
        </Style>

        <BooleanToVisibilityConverter x:Key="Editor.BoolVisivel" />

        <!-- Botão alternável da barra da linha do tempo (ímã, ripple) -->
        <Style x:Key="Editor.Alternar" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Med.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Fundo" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource Med.PanelHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource Med.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botões pequenos dos cabeçalhos de trilha -->
        <Style x:Key="Editor.TrilhaBotao" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Med.TextMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" Background="{TemplateBinding Background}" CornerRadius="3" Width="24" Height="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource Med.PanelHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Med.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navegação vertical do painel A -->
        <ControlTemplate x:Key="Editor.NavModelo" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </ControlTemplate>

        <Style x:Key="Editor.NavBase" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Med.TextMuted}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="2,6,2,4" />
            <Setter Property="ToolTip" Value="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource Self}}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource Editor.NavModelo}" />
        </Style>

        <Style x:Key="Editor.Nav.Media" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Media}">
                    <Setter Property="BorderBrush" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Videos" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Videos}">
                    <Setter Property="BorderBrush" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Images" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Images}">
                    <Setter Property="BorderBrush" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Audio" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Audio}">
                    <Setter Property="BorderBrush" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Graphics" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Graphics}">
                    <Setter Property="BorderBrush" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Texts" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Texts}">
                    <Setter Property="BorderBrush" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Transitions" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Transitions}">
                    <Setter Property="BorderBrush" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Effects" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Effects}">
                    <Setter Property="BorderBrush" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Color" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Color}">
                    <Setter Property="BorderBrush" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.AI" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.AI}">
                    <Setter Property="BorderBrush" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Placeholder da pesquisa: visível somente com o campo vazio -->
        <Style x:Key="Editor.Placeholder" TargetType="TextBlock" BasedOn="{StaticResource Med.MutedText}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=CampoPesquisa}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="GradeEditor">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="LinhaCentral" Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="LinhaInferior" Height="300" MinHeight="200" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColunaPrincipal" Width="*" MinWidth="760" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="ColunaPropriedades" Width="400" MinWidth="340" />
        </Grid.ColumnDefinitions>

        <!-- 1. Barra de título: logotipo, menu, ações rápidas, projeto e Exportar.
             Fica sob a área de legenda da janela (WindowChrome); os botões de
             minimizar/maximizar/fechar são desenhados pela MainWindow à direita. -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{DynamicResource Med.Panel}" MinHeight="40"
                BorderBrush="{DynamicResource Med.Border}" BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{x:Static vw:MainWindow.CaptionButtonsWidth}" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="/Assets/logo-64.png" Width="20" Height="20" Margin="12,0,6,0"
                   VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.Name="Logotipo" />
        <Menu Grid.Column="1" VerticalAlignment="Center" Background="Transparent"
              WindowChrome.IsHitTestVisibleInChrome="True">
            <MenuItem Header="{StaticResource Editor.Menu.Arquivo}">
                <MenuItem Header="{StaticResource Editor.Menu.NovoProjeto}" Command="{Binding NewProjectCommand}" ctl:ShortcutText.Action="projeto.novo" />
                <MenuItem Header="{StaticResource Editor.Menu.Abrir}" Command="{Binding OpenCommand}" ctl:ShortcutText.Action="projeto.abrir" />
                <Separator />
                <MenuItem Header="{StaticResource Editor.Menu.ImportarMidia}" Command="{Binding ImportMediaCommand}" ctl:ShortcutText.Action="midia.importar" />
                <MenuItem Header="{StaticResource Editor.Menu.ImportarSequencia}" Command="{Binding ImportSequenceCommand}" />
                <Separator />
                <MenuItem Header="{StaticResource Editor.Menu.Salvar}" Command="{Binding SaveCommand}" ctl:ShortcutText.Action="projeto.salvar" />
                <MenuItem Header="{StaticResource Editor.Menu.SalvarComo}" Command="{Binding SaveAsCommand}" ctl:ShortcutText.Action="projeto.salvarComo" />
                <MenuItem Header="{StaticResource Editor.Menu.CopiaSeguranca}" Command="{Binding CreateBackupCommand}" />
                <Separator />
                <MenuItem Header="{StaticResource Editor.Menu.Exportar}" Command="{Binding ExportCommand}" ctl:ShortcutText.Action="projeto.exportar" />
                <MenuItem Header="{StaticResource Editor.Menu.FilaRenderizacao}" Command="{Binding ShowRenderQueueCommand}" />
                <Separator />
                <MenuItem Header="{StaticResource Editor.Menu.Inicio}" Command="{Binding GoHomeCommand}" />
            </MenuItem>
            <MenuItem Header="{StaticResource Editor.Menu.Editar}">
                <MenuItem Header="{StaticResource Editor.Menu.Desfazer}" Command="{Binding UndoCommand}" ctl:ShortcutText.Action="editar.desfazer" ToolTip="{Binding UndoToolTip}" />
                <MenuItem Header="{StaticResource Editor.Menu.Refazer}" Command="{Binding RedoCommand}" ctl:ShortcutText.Action="editar.refazer" ToolTip="{Binding RedoToolTip}" />
                <Separator />
                <MenuItem Header="{StaticResource Editor.Menu.SelecionarTudo}" Command="{Binding Timeline.SelectAllCommand}" ctl:ShortcutText.Action="linha.selecionarTudo" AutomationProperties.Name="Selecionar tudo" />
                <Separator />
                <MenuItem Header="{StaticResource Editor.Menu.Dividir}" Command="{Binding Timeline.SplitCommand}" ctl:ShortcutText.Action="linha.dividir" AutomationProperties.Name="Dividir" />
                <MenuItem Header="{StaticResource Editor.Menu.JuntarCortes}" Command="{Binding Timeline.JoinCutsCommand}" ToolTip="{StaticResource Editor.Menu.JuntarCortes.Dica}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Juntar os cortes" />
                <MenuItem Header="{StaticResource Editor.Menu.Recortar}" Command="{Binding Timeline.CutCommand}" ctl:ShortcutText.Action="linha.recortar" AutomationProperties.Name="Recortar" />
                <MenuItem Header="{StaticResource Editor.Menu.Copiar}" Command="{Binding Timeline.CopyCommand}" ctl:ShortcutText.Action="linha.copiar" AutomationProperties.Name="Copiar" />
                <MenuItem Header="{StaticResource Editor.Menu.ColarNoCursor}" Command="{Binding Timeline.PasteCommand}" ctl:ShortcutText.Action="linha.colar" AutomationProperties.Name="Colar no cursor" />
                <MenuItem Header="{StaticResource Editor.Menu.Duplicar}" Command="{Binding Timeline.DuplicateCommand}" ctl:ShortcutText.Action="linha.duplicar" AutomationProperties.Name="Duplicar" />
                <Separator />
                <MenuItem Header="{StaticResource Editor.Menu.Excluir}" Command="{Binding Timeline.DeleteCommand}" ctl:ShortcutText.Action="linha.excluir" AutomationProperties.Name="Excluir" />
                <MenuItem Header="{StaticResource Editor.Menu.ExcluirFechando}" Command="{Binding Timeline.RippleDeleteCommand}" ctl:ShortcutText.Action="linha.excluirFechando" AutomationProperties.Name="Excluir e fechar o espaço" />
                <MenuItem Header="{StaticResource Editor.Menu.ExcluirJuntando}" Command="{Binding Timeline.DeleteAndJoinCommand}" AutomationProperties.Name="Excluir e juntar"
                          ToolTip="{StaticResource Editor.Menu.ExcluirJuntando.Dica}" />
            </MenuItem>
            <MenuItem Header="{StaticResource Editor.Menu.Visualizar}">
                <MenuItem x:Name="MenuModoLayout" Header="{StaticResource Editor.Menu.ModoLayout}" AutomationProperties.Name="Modo do layout">
                    <MenuItem Header="{StaticResource Editor.Layout.Padrao}" Tag="Padrao" IsCheckable="True" IsChecked="True" Click="ModoLayout_Click" AutomationProperties.Name="Layout padrão" />
                    <MenuItem Header="{StaticResource Editor.Layout.LinhaDoTempo}" Tag="LinhaDoTempo" IsCheckable="True" Click="ModoLayout_Click" AutomationProperties.Name="Layout linha do tempo" />
                    <MenuItem Header="{StaticResource Editor.Layout.Video}" Tag="Video" IsCheckable="True" Click="ModoLayout_Click" AutomationProperties.Name="Layout vídeo" />
                </MenuItem>
                <MenuItem x:Name="MenuQualidade" Header="{StaticResource Editor.Menu.QualidadeReproducao}" AutomationProperties.Name="Qualidade de reprodução"
                          SubmenuOpened="MenuQualidade_SubmenuOpened">
                    <MenuItem Header="…" />
                </MenuItem>
                <MenuItem x:Name="MenuZoomVideo" Header="{StaticResource Editor.Menu.ZoomVideo}" AutomationProperties.Name="Nível de zoom no vídeo">
                    <MenuItem Header="{StaticResource Editor.Zoom.Ajuste}" Tag="0" IsCheckable="True" IsChecked="True" Click="ZoomVideo_Click" AutomationProperties.Name="Zoom: ajuste" />
                    <MenuItem Header="10%" Tag="0.1" IsCheckable="True" Click="ZoomVideo_Click" AutomationProperties.Name="Zoom 10%" />
                    <MenuItem Header="25%" Tag="0.25" IsCheckable="True" Click="ZoomVideo_Click" AutomationProperties.Name="Zoom 25%" />
                    <MenuItem Header="50%" Tag="0.5" IsCheckable="True" Click="ZoomVideo_Click" AutomationProperties.Name="Zoom 50%" />
                    <MenuItem Header="75%" Tag="0.75" IsCheckable="True" Click="ZoomVideo_Click" AutomationProperties.Name="Zoom 75%" />
                    <MenuItem Header="100%" Tag="1" IsCheckable="True" Click="ZoomVideo_Click" AutomationProperties.Name="Zoom 100%" />
                    <MenuItem Header="200%" Tag="2" IsCheckable="True" Click="ZoomVideo_Click" AutomationProperties.Name="Zoom 200%" />
                    <MenuItem Header="400%" Tag="4" IsCheckable="True" Click="ZoomVideo_Click" AutomationProperties.Name="Zoom 400%" />
                </MenuItem>
                <Separator />
                <MenuItem Header="{StaticResource Editor.Menu.ReproduzirPausar}" Command="{Binding Preview.PlayPauseCommand}" ctl:ShortcutText.Action="reproducao.reproduzir" AutomationProperties.Name="Reproduzir/Pausar" />
                <MenuItem Header="{StaticResource Editor.Menu.Parar}" Command="{Binding Preview.StopCommand}" AutomationProperties.Name="Parar" />
                <MenuItem Header="{StaticResource Editor.Menu.Loop}" IsCheckable="True" IsChecked="{Binding Preview.LoopPlayback}" AutomationProperties.Name="Intervalo de reprodução em loop"
                          ToolTip="{StaticResource Editor.Menu.Loop.Dica}" />
                <MenuItem x:Name="MenuRegua" Header="{StaticResource Editor.Menu.Regua}" IsCheckable="True" Click="Regua_Click" AutomationProperties.Name="Régua" />
            </MenuItem>
            <MenuItem Header="{StaticResource Editor.Menu.Projeto}">
                <MenuItem Header="{StaticResource Editor.Menu.EmpacotarMidias}" Command="{Binding PackageMediaCommand}" />
                <MenuItem Header="{StaticResource Editor.Menu.MidiasAusentes}" Command="{Binding ShowMissingMediaCommand}" />
            </MenuItem>
            <MenuItem Header="{StaticResource Editor.Menu.Ferramentas}">
                <MenuItem Header="{StaticResource Editor.Ferramenta.Mixer}" Click="Mixer_Click" />
                <MenuItem Header="{StaticResource Editor.Ferramenta.EditorLegendas}" Click="EditorLegendas_Click" IsEnabled="{Binding Timeline.HasSession}" />
                <MenuItem Header="{StaticResource Editor.Ferramenta.ImportarLegendas}" Command="{Binding TextLibrary.ImportSubtitlesCommand}" />
                <MenuItem Header="{StaticResource Editor.Ferramenta.ExportarLegendas}" Command="{Binding TextLibrary.ExportSubtitlesCommand}" />
                <Separator />
                <MenuItem Header="{StaticResource Editor.Ferramenta.ModelosIA}" Click="ModelosIA_Click" AutomationProperties.Name="Modelos de IA" />
                <Separator />
                <MenuItem Header="Configurações…" Click="Configuracoes_Click" AutomationProperties.Name="Configurações" ctl:ShortcutText.Action="app.configuracoes" />
            </MenuItem>
            <MenuItem Header="{StaticResource Editor.Menu.Ajuda}">
                <MenuItem Header="Manual do usuário" Click="Manual_Click" AutomationProperties.Name="Manual do usuário" ctl:ShortcutText.Action="app.ajuda" />
                <MenuItem Header="Atalhos de teclado…" Click="Atalhos_Click" AutomationProperties.Name="Atalhos de teclado" />
                <Separator />
                <MenuItem Header="Informações do sistema…" Click="InformacoesSistema_Click" AutomationProperties.Name="Informações do sistema" />
                <MenuItem Header="Abrir pasta de logs" Click="PastaLogs_Click" AutomationProperties.Name="Abrir pasta de logs" />
                <MenuItem Header="Licenças de terceiros" Click="Licencas_Click" AutomationProperties.Name="Licenças de terceiros" />
                <Separator />
                <MenuItem Header="Sobre o Meu Editor de Vídeo…" Click="Sobre_Click" AutomationProperties.Name="Sobre" />
                <MenuItem Header="{StaticResource Editor.Menu.VerificarAtualizacoes}" IsEnabled="False" AutomationProperties.Name="Verificar atualizações" />
                <MenuItem Header="{StaticResource Editor.Menu.NotasLancamento}" IsEnabled="False" AutomationProperties.Name="Notas de lançamento" />
            </MenuItem>
            </Menu>

            <StackPanel Grid.Column="2" WindowChrome.IsHitTestVisibleInChrome="True" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                <Border Width="1" Background="{DynamicResource Med.Border}" Margin="4,10,8,10" />
                    <Button AutomationProperties.Name="{StaticResource Editor.Acao.Salvar}" Style="{StaticResource Editor.Acao}" Command="{Binding SaveCommand}"
                            ToolTip="{StaticResource Editor.Acao.Salvar}" ToolTipService.ShowOnDisabled="True">
                        <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE74E;" />
                    </Button>
                    <Button AutomationProperties.Name="{StaticResource Editor.Acao.Desfazer}" Style="{StaticResource Editor.Acao}" Command="{Binding UndoCommand}"
                            ToolTip="{Binding UndoToolTip}" ToolTipService.ShowOnDisabled="True">
                        <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE7A7;" />
                    </Button>
                    <Button AutomationProperties.Name="{StaticResource Editor.Acao.Refazer}" Style="{StaticResource Editor.Acao}" Command="{Binding RedoCommand}"
                            ToolTip="{Binding RedoToolTip}" ToolTipService.ShowOnDisabled="True">
                        <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE7A6;" />
                    </Button>
            </StackPanel>

            <StackPanel Grid.Column="3" WindowChrome.IsHitTestVisibleInChrome="True" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding ProjectName}" Foreground="{DynamicResource Med.Text}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                           ToolTip="{Binding ProjectSummary}" />
                <TextBlock Text="{StaticResource Editor.NaoSalvo}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Med.Accent}"
                           Visibility="{Binding IsDirty, Converter={StaticResource Editor.BoolToVis}}" />
                <Button AutomationProperties.Name="{StaticResource Editor.MidiasAusentes}" Command="{Binding ShowMissingMediaCommand}"
                        Margin="12,0,0,0" Padding="8,2">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Editor.Acao}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MissingMediaCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Med.Danger}" />
                        <TextBlock Margin="6,0,0,0" Foreground="{DynamicResource Med.Danger}">
                            <Run Text="{Binding MissingMediaCount, Mode=OneWay}" /><Run Text=" " /><Run Text="{StaticResource Editor.MidiasAusentesSufixo}" />
                        </TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="4" WindowChrome.IsHitTestVisibleInChrome="True" Orientation="Horizontal" VerticalAlignment="Center">
                <Button AutomationProperties.Name="{StaticResource Editor.Acao.AlternarTema}" Style="{StaticResource Editor.Acao}" Command="{Binding ToggleThemeCommand}"
                        ToolTip="{StaticResource Editor.Acao.AlternarTema}" ToolTipService.ShowOnDisabled="True">
                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE793;" />
                </Button>
                <Button AutomationProperties.Name="{StaticResource Editor.Acao.FilaRenderizacao}" Style="{StaticResource Editor.Acao}" Command="{Binding ShowRenderQueueCommand}"
                        ToolTip="{StaticResource Editor.Acao.FilaRenderizacao}" Margin="4,0,0,0">
                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE896;" />
                </Button>
                <Button AutomationProperties.Name="{StaticResource Editor.Acao.Exportar}" Style="{StaticResource Med.AccentButton}" Command="{Binding ExportCommand}"
                        Margin="8,0,0,0" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE898;" />
                        <TextBlock Text="{StaticResource Editor.Acao.Exportar}" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        </Border>

        <!-- 3. Área central: Biblioteca | Monitor | Propriedades -->
        <Grid x:Name="AreaCentral" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColunaBiblioteca" Width="560" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- Painel A: Biblioteca -->
            <Border x:Name="PainelBiblioteca" Grid.Column="0" Style="{StaticResource Editor.Painel}" Margin="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Abas da biblioteca: ícone em cima, rótulo embaixo -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource Med.Border}" BorderThickness="0,0,0,1" />
                    <UniformGrid Grid.Row="0" Rows="1" Margin="4,2,4,0">
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Midias}" Style="{StaticResource Editor.Nav.Media}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Media}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8F1;" FontSize="18" HorizontalAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Midias}" Margin="0,3,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Videos}" Style="{StaticResource Editor.Nav.Videos}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Videos}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE714;" FontSize="18" HorizontalAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Videos}" Margin="0,3,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Imagens}" Style="{StaticResource Editor.Nav.Images}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Images}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8B9;" FontSize="18" HorizontalAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Imagens}" Margin="0,3,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Audios}" Style="{StaticResource Editor.Nav.Audio}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Audio}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8D6;" FontSize="18" HorizontalAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Audios}" Margin="0,3,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.ElementosGraficos}" Style="{StaticResource Editor.Nav.Graphics}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Graphics}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8F4;" FontSize="18" HorizontalAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.ElementosGraficos}" Margin="0,3,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Textos}" Style="{StaticResource Editor.Nav.Texts}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Texts}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8D2;" FontSize="18" HorizontalAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Textos}" Margin="0,3,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Transicoes}" Style="{StaticResource Editor.Nav.Transitions}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Transitions}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8AB;" FontSize="18" HorizontalAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Transicoes}" Margin="0,3,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Efeitos}" Style="{StaticResource Editor.Nav.Effects}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Effects}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE706;" FontSize="18" HorizontalAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Efeitos}" Margin="0,3,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Cor}" Style="{StaticResource Editor.Nav.Color}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Color}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE790;" FontSize="18" HorizontalAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Cor}" Margin="0,3,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.IA}" Style="{StaticResource Editor.Nav.AI}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.AI}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE99A;" FontSize="18" HorizontalAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.IA}" Margin="0,3,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                    </UniformGrid>

                    <Grid Grid.Row="1" Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <Button AutomationProperties.Name="{StaticResource Editor.Acao.ImportarMidia}" Style="{StaticResource Editor.Acao}" Command="{Binding ImportMediaCommand}"
                                        HorizontalAlignment="Left" Margin="0" Padding="8,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8B5;" FontSize="14" />
                                        <TextBlock Text="{StaticResource Editor.Acao.ImportarMidia}" Margin="6,0,0,0" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button AutomationProperties.Name="{StaticResource Editor.Acao.ImportarSequencia}"
                                        ToolTip="{StaticResource Editor.Acao.ImportarSequencia}"
                                        Style="{StaticResource Editor.Controle}" Command="{Binding ImportSequenceCommand}"
                                        Margin="6,0,0,0">
                                    <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE8B9;" />
                                </Button>
                            </StackPanel>

                            <StackPanel Margin="0,8,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMediaSection}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid>
                                    <TextBox x:Name="CampoPesquisa"
                                             AutomationProperties.Name="{StaticResource Editor.Biblioteca.Pesquisar}"
                                             Text="{Binding Library.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{DynamicResource Med.PanelAlt}"
                                             Foreground="{DynamicResource Med.Text}"
                                             BorderBrush="{DynamicResource Med.Border}"
                                             CaretBrush="{DynamicResource Med.Text}"
                                             Padding="6,4" VerticalContentAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Pesquisar}"
                                               Style="{StaticResource Editor.Placeholder}" />
                                </Grid>

                                <ComboBox AutomationProperties.Name="{StaticResource Editor.Biblioteca.Categoria}"
                                          ToolTip="{StaticResource Editor.Biblioteca.Categoria}"
                                          ItemsSource="{Binding Library.Categories}"
                                          SelectedItem="{Binding Library.SelectedCategory}"
                                          Background="{DynamicResource Med.PanelAlt}"
                                          Foreground="{DynamicResource Med.Text}"
                                          BorderBrush="{DynamicResource Med.Border}"
                                          Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- IA: os recursos são aplicados ao clipe selecionado (aba IA das propriedades); aqui ficam o guia e os modelos. -->
                        <StackPanel Grid.Row="1" Margin="12" VerticalAlignment="Top" AutomationProperties.Name="Inteligência artificial"
                                    Visibility="{Binding IsAiSection, Converter={StaticResource Editor.BoolToVis}}">
                            <TextBlock Text="{StaticResource Editor.Biblioteca.IA.Titulo}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{StaticResource Editor.Biblioteca.IA.Texto}" TextWrapping="Wrap" Style="{StaticResource Med.MutedText}" />
                            <TextBlock Text="{StaticResource Editor.Biblioteca.IA.Recursos}" TextWrapping="Wrap" Margin="0,10,0,0" Style="{StaticResource Med.MutedText}" />
                            <Button Content="{StaticResource Editor.Biblioteca.IA.Modelos}" Click="ModelosIA_Click" Margin="0,12,0,0"
                                    HorizontalAlignment="Stretch" AutomationProperties.Name="Gerenciar modelos de IA" />
                        </StackPanel>

                        <!-- Textos: modelos (texto, título, tarja, créditos, legenda) e legendas SRT/VTT (F8) -->
                        <DockPanel Grid.Row="1" Margin="0,8,0,0" DataContext="{Binding TextLibrary}"
                                   Visibility="{Binding DataContext.IsTextSection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Editor.BoolToVis}}">
                            <StackPanel DockPanel.Dock="Bottom" Margin="4,8,4,0">
                                <Button Content="Adicionar no cursor" HorizontalAlignment="Stretch" AutomationProperties.Name="Adicionar texto no cursor"
                                        Command="{Binding AddPresetCommand}" />
                                <TextBlock Text="Legendas" Style="{StaticResource Med.SectionTitle}" FontSize="13" Margin="0,12,0,6" />
                                <Button Content="Importar SRT/VTT…" HorizontalAlignment="Stretch" Margin="0,0,0,4" AutomationProperties.Name="Importar legendas SRT ou VTT"
                                        Command="{Binding ImportSubtitlesCommand}" />
                                <Button Content="Editor de legendas…" HorizontalAlignment="Stretch" Margin="0,0,0,4" AutomationProperties.Name="Abrir o editor de legendas"
                                        Click="EditorLegendas_Click" />
                                <Button Content="Exportar SRT/VTT…" HorizontalAlignment="Stretch" AutomationProperties.Name="Exportar legendas SRT ou VTT"
                                        Command="{Binding ExportSubtitlesCommand}" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Med.MutedText}" TextWrapping="Wrap" Margin="4,0,4,8"
                                       Text="Clique duas vezes num modelo para inseri-lo no cursor. Edite o conteúdo e o estilo na aba Texto." />
                            <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" AutomationProperties.Name="Modelos de texto"
                                     Background="{DynamicResource Med.PanelAlt}" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="ModelosTexto_MouseDoubleClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="4" Background="{DynamicResource Med.ClipText}" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Sample}" Foreground="White" FontWeight="Bold" FontSize="14"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Med.Text}" />
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Style="{StaticResource Med.MutedText}" FontSize="11" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- Elementos gráficos: formas vetoriais e SVG (F9) -->
                        <DockPanel Grid.Row="1" Margin="0,8,0,0" DataContext="{Binding GraphicsLibrary}"
                                   Visibility="{Binding DataContext.IsGraphicsSection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Editor.BoolToVis}}">
                            <StackPanel DockPanel.Dock="Bottom" Margin="4,8,4,0">
                                <Button Content="Adicionar no cursor" HorizontalAlignment="Stretch" AutomationProperties.Name="Adicionar elemento gráfico no cursor"
                                        Command="{Binding AddPresetCommand}" />
                                <Button Content="Importar SVG…" HorizontalAlignment="Stretch" Margin="0,4,0,0" AutomationProperties.Name="Importar gráfico vetorial SVG"
                                        Command="{Binding ImportSvgCommand}" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Med.MutedText}" TextWrapping="Wrap" Margin="4,0,4,8"
                                       Text="Clique duas vezes numa forma para inseri-la no cursor. Ajuste forma, cores e máscaras na aba Composição." />
                            <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" AutomationProperties.Name="Elementos gráficos"
                                     Background="{DynamicResource Med.PanelAlt}" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="ElementosGraficos_MouseDoubleClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2,3">
                                            <Border Width="30" Height="30" CornerRadius="4" Background="{DynamicResource Med.MonitorBackground}">
                                                <TextBlock Text="{Binding Glyph}" Foreground="{Binding Color}" FontSize="16"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Med.Text}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- Transições, efeitos e cor: aplicam ao clipe selecionado na linha do tempo (F6) -->
                        <DockPanel Grid.Row="1" Margin="0,8,0,0">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEffectSection}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Med.MutedText}" TextWrapping="Wrap" Margin="4,0,4,8"
                                       Text="Selecione um clipe na linha do tempo e clique duas vezes num item (ou use Aplicar)." />
                            <Button DockPanel.Dock="Bottom" Content="Aplicar ao clipe selecionado" Margin="4,8,4,0" HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Aplicar ao clipe selecionado"
                                    Command="{Binding ApplySectionItemCommand}" CommandParameter="{Binding SelectedItem, ElementName=ListaEfeitos}" />
                            <ListBox x:Name="ListaEfeitos" ItemsSource="{Binding SectionItems}" AutomationProperties.Name="Catálogo"
                                     Background="{DynamicResource Med.PanelAlt}" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="ListaEfeitos_MouseDoubleClick">
                                <ListBox.Resources>
                                    <ResourceDictionary Source="Panels/InspectorTemplates.xaml" />
                                </ListBox.Resources>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </DockPanel>

                        <!-- Área da biblioteca: lista, arrastar e soltar (RF027) -->
                        <Border x:Name="BibliotecaArea" Grid.Row="1" Margin="0,8,0,0"
                                Background="{DynamicResource Med.PanelAlt}" CornerRadius="6"
                                AllowDrop="True"
                                DragEnter="BibliotecaArea_DragOver"
                                DragOver="BibliotecaArea_DragOver"
                                DragLeave="BibliotecaArea_DragLeave"
                                Drop="BibliotecaArea_Drop">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMediaSection}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <ListBox ItemsSource="{Binding Library.ItemsView}"
                                         PreviewMouseRightButtonDown="Biblioteca_PreviewMouseRightButtonDown"
                                         PreviewMouseLeftButtonDown="Biblioteca_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="Biblioteca_PreviewMouseMove"
                                         MouseDoubleClick="Biblioteca_MouseDoubleClick"
                                         SelectedItem="{Binding Library.SelectedItem}"
                                         AutomationProperties.Name="{StaticResource Editor.Biblioteca.Midias}"
                                         Background="Transparent" BorderThickness="0"
                                         Margin="4"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.InputBindings>
                                        <KeyBinding Key="Delete" Command="{Binding Library.RemoveSelectedCommand}" />
                                        <KeyBinding Key="F2" Command="{Binding Library.RenameSelectedCommand}" />
                                    </ListBox.InputBindings>
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{StaticResource Editor.Ferramenta.AdicionarMidia}"
                                                      Command="{Binding PlacementTarget.DataContext.Timeline.AddSelectedMediaCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="{StaticResource Editor.Biblioteca.Renomear}"
                                                      Command="{Binding PlacementTarget.DataContext.Library.RenameSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{StaticResource Editor.Biblioteca.DefinirCategoria}"
                                                      Command="{Binding PlacementTarget.DataContext.Library.SetCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{StaticResource Editor.Biblioteca.RemoverCategoria}"
                                                      Command="{Binding PlacementTarget.DataContext.Library.ClearCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="{StaticResource Editor.Biblioteca.GerarProxy}"
                                                      Command="{Binding PlacementTarget.DataContext.Library.GenerateProxyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{StaticResource Editor.Biblioteca.ExcluirProxy}"
                                                      Command="{Binding PlacementTarget.DataContext.Library.DeleteProxyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="{StaticResource Editor.Biblioteca.RemoverDoProjeto}"
                                                      Command="{Binding PlacementTarget.DataContext.Library.RemoveSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Padding" Value="4" />
                                            <Setter Property="Margin" Value="2" />
                                            <Setter Property="Width" Value="136" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Top" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type media:MediaItemViewModel}">
                                            <Grid ToolTip="{Binding ToolTip}" Background="Transparent">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Opacity" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                <Setter Property="Opacity" Value="0.6" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0" Height="72" CornerRadius="4"
                                                        Background="{DynamicResource Med.MonitorBackground}" ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                        <Path Data="{Binding Waveform}" Stretch="Fill"
                                                              Fill="{DynamicResource Med.ClipAudio}" Margin="2,4">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Waveform}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                        <TextBlock Text="{Binding KindGlyph}" FontSize="24"
                                                                   HorizontalAlignment="Center" Foreground="{DynamicResource Med.TextMuted}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Med.Icon}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Thumbnail}" Value="{x:Null}" />
                                                                                <Condition Binding="{Binding Waveform}" Value="{x:Null}" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3"
                                                                Background="#99000000" Padding="3,0">
                                                            <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="White" />
                                                        </Border>
                                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3"
                                                                Background="#CC1E6FD9" Padding="3,0" CornerRadius="2"
                                                                Visibility="{Binding HasProxyLabel, Converter={StaticResource Editor.BoolToVis}}"
                                                                ToolTip="Proxy de edição 540p (usado só na pré-visualização)">
                                                            <TextBlock Text="{Binding ProxyLabel}" FontSize="10" Foreground="White"
                                                                       AutomationProperties.Name="{Binding ProxyLabel}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <Grid Grid.Row="1" Margin="0,4,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Med.Text}" />
                                                    <TextBlock Grid.Row="1" Text="{Binding Details}" Style="{StaticResource Med.MutedText}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="2" Text="{StaticResource Editor.Biblioteca.ArquivoNaoEncontrado}"
                                                               Foreground="{DynamicResource Med.Danger}" FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Estado vazio -->
                                <TextBlock Text="{Binding Library.EmptyMessage}"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Med.MutedText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Library.VisibleCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Progresso da importação -->
                                <Border VerticalAlignment="Bottom" Background="{DynamicResource Med.Panel}" Padding="8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Library.IsImporting}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Library.ImportStatus}" FontSize="11"
                                                   Foreground="{DynamicResource Med.Text}" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Height="4" Maximum="100" Margin="0,4,0,0"
                                                     Value="{Binding Library.ImportPercent}"
                                                     AutomationProperties.Name="{StaticResource Editor.Biblioteca.ProgressoImportacao}" />
                                    </StackPanel>
                                </Border>

                                <!-- Dica ao arrastar arquivos sobre a área -->
                                <Border x:Name="DicaSoltar" Visibility="Collapsed" IsHitTestVisible="False"
                                        Margin="2" BorderBrush="{DynamicResource Med.Accent}" BorderThickness="2"
                                        CornerRadius="6" Background="#333B82F6">
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.SoltarParaImportar}"
                                               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Med.Text}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter x:Name="DivisorBiblioteca" Grid.Column="1" Width="3" MinWidth="0" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Background="{DynamicResource Med.Background}" />

            <!-- Painel B: Monitor -->
            <Border x:Name="PainelMonitor" Grid.Column="2" Style="{StaticResource Editor.Painel}" Margin="1">
                <Grid Margin="8,0,8,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho: origem da imagem e qualidade da pré-visualização -->
                    <Grid Grid.Row="0" Height="36">
                        <Border HorizontalAlignment="Left" BorderBrush="{DynamicResource Med.Accent}" BorderThickness="0,0,0,2" Padding="2,0">
                            <TextBlock Text="{StaticResource Editor.Monitor.LinhaDoTempo}" Foreground="{DynamicResource Med.Accent}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding Preview.Qualities}" SelectedItem="{Binding Preview.Quality}"
                                      DisplayMemberPath="Label" MinWidth="88" Margin="0,0,4,0"
                                      AutomationProperties.Name="{StaticResource Editor.Monitor.Qualidade}"
                                      ToolTip="{StaticResource Editor.Monitor.Qualidade}" />
                            <ToggleButton Style="{StaticResource Editor.Alternar}" IsChecked="{Binding Preview.UseProxies}"
                                          AutomationProperties.Name="{StaticResource Editor.Monitor.UsarProxies}"
                                          ToolTip="{StaticResource Editor.Monitor.UsarProxies}">
                                <TextBlock Text="Proxy" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </ToggleButton>
                            <!-- Maximizar: o monitor cobre a biblioteca e a linha do tempo; Propriedades continua visível -->
                            <ToggleButton x:Name="BotaoMaximizarMonitor" Style="{StaticResource Editor.Alternar}" Margin="4,0,0,0"
                                          Checked="MaximizarMonitor_Changed" Unchecked="MaximizarMonitor_Changed"
                                          AutomationProperties.Name="{StaticResource Editor.Monitor.Maximizar}"
                                          ToolTip="{StaticResource Editor.Monitor.Maximizar}">
                                <TextBlock x:Name="IconeMaximizarMonitor" Style="{StaticResource Editor.Icone}" Text="&#xE740;" />
                            </ToggleButton>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="Monitor" Grid.Row="1" Background="{DynamicResource Med.MonitorBackground}" CornerRadius="4" ClipToBounds="True"
                            MouseLeftButtonDown="Monitor_MouseLeftButtonDown">
                        <Grid>
                            <!-- Nível de zoom (Visualizar): em "Ajuste" o conteúdo ocupa o monitor; nos percentuais tem tamanho fixo e rola -->
                            <ScrollViewer x:Name="RolagemMonitor" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                                          Focusable="False" AutomationProperties.Name="{StaticResource Editor.Menu.ZoomVideo}">
                            <Grid x:Name="ConteudoMonitor" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="ImagemMonitor" Source="{Binding Preview.Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear"
                                   AutomationProperties.Name="{StaticResource Editor.Monitor.Imagem}" SizeChanged="ImagemMonitor_SizeChanged" />
                            <!-- Edição de máscaras e regiões de rastreamento sobre a imagem (F9) -->
                            <ctl:CompositionOverlay Editor="{Binding CompositionInspector}" />
                            <!-- Comparar antes/depois: alça arrastável sobre a linha divisória (desenhada pelo renderizador) -->
                            <Canvas x:Name="CamadaComparacao" IsVisibleChanged="CamadaComparacao_IsVisibleChanged" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Width="{Binding ActualWidth, ElementName=ImagemMonitor}" Height="{Binding ActualHeight, ElementName=ImagemMonitor}"
                                    Visibility="{Binding Preview.CompareMode, Converter={StaticResource Editor.BoolToVis}}">
                                <Border x:Name="AlcaComparacao" Width="24" Background="Transparent" Cursor="SizeWE"
                                        Height="{Binding ActualHeight, ElementName=CamadaComparacao}"
                                        MouseLeftButtonDown="AlcaComparacao_MouseLeftButtonDown" MouseMove="AlcaComparacao_MouseMove"
                                        MouseLeftButtonUp="AlcaComparacao_MouseLeftButtonUp"
                                        AutomationProperties.Name="{StaticResource Editor.Monitor.LinhaComparacao}"
                                        ToolTip="{StaticResource Editor.Monitor.LinhaComparacao}">
                                    <Border Width="28" Height="28" CornerRadius="14" Background="White" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Margin="-2,0">
                                        <TextBlock Text="&#xE76B;&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Foreground="Black"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Border>
                            </Canvas>
                            <!-- Régua (Visualizar › Régua): graduada em pixels do vídeo -->
                            <ctl:MonitorRuler x:Name="ReguaMonitor" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Width="{Binding ActualWidth, ElementName=ImagemMonitor}" Height="{Binding ActualHeight, ElementName=ImagemMonitor}"
                                              VideoWidth="{Binding Timeline.Project.Settings.Width, FallbackValue=1920}"
                                              VideoHeight="{Binding Timeline.Project.Settings.Height, FallbackValue=1080}" />
                            </Grid>
                            </ScrollViewer>
                            <TextBlock Text="{StaticResource Editor.Monitor.PreVisualizacao}" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Med.MutedText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Preview.HasContent}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Preview.Status}" FontSize="10" Margin="6,4" Opacity="0.7"
                                       Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding Preview.AutoNotice}" FontSize="11" Margin="6,4" TextWrapping="Wrap" MaxWidth="420"
                                       Foreground="#FFD54F" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Barra de posição: arrastar move o cursor da linha do tempo -->
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="0" Maximum="{Binding Timeline.DurationSeconds}"
                                Value="{Binding Timeline.PlayheadSeconds}" VerticalAlignment="Center"
                                IsMoveToPointEnabled="True" Focusable="False"
                                AutomationProperties.Name="{StaticResource Editor.Monitor.Posicao}" />
                        <TextBlock Grid.Column="1" Text="{Binding Timeline.TimeDisplay}"
                                   FontFamily="Consolas" FontSize="12"
                                   Foreground="{DynamicResource Med.Text}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>

                    <!-- Controles: transporte à esquerda; volume, captura e tela cheia à direita -->
                    <Grid Grid.Row="3" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button AutomationProperties.Name="{StaticResource Editor.Monitor.IrInicio}" Style="{StaticResource Editor.Controle}" Command="{Binding Timeline.GoToStartCommand}" ToolTip="{StaticResource Editor.Monitor.IrInicio}">
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE892;" />
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Monitor.Retroceder}" Style="{StaticResource Editor.Controle}" Command="{Binding Timeline.StepBackCommand}" ToolTip="{StaticResource Editor.Monitor.Retroceder}">
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xEB9E;" />
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Monitor.ReproduzirPausar}" Style="{StaticResource Editor.Controle}" Command="{Binding Preview.PlayPauseCommand}" ToolTip="{Binding Preview.PlayToolTip}">
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="{Binding Preview.PlayGlyph, FallbackValue=&#xE768;}" />
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Monitor.Avancar}" Style="{StaticResource Editor.Controle}" Command="{Binding Timeline.StepForwardCommand}" ToolTip="{StaticResource Editor.Monitor.Avancar}">
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xEB9D;" />
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Monitor.IrFim}" Style="{StaticResource Editor.Controle}" Command="{Binding Timeline.GoToEndCommand}" ToolTip="{StaticResource Editor.Monitor.IrFim}">
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE893;" />
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE767;" FontSize="14" Margin="0,0,6,0"
                                       ToolTip="{StaticResource Editor.Monitor.Volume}" />
                            <Slider Width="80" Minimum="0" Maximum="100" Value="{Binding Preview.Volume}"
                                    AutomationProperties.Name="{StaticResource Editor.Monitor.Volume}"
                                    VerticalAlignment="Center" ToolTip="{StaticResource Editor.Monitor.Volume}" />
                            <Button Margin="8,0,0,0" AutomationProperties.Name="{StaticResource Editor.Monitor.CapturarQuadro}" Style="{StaticResource Editor.Controle}"
                                    Command="{Binding Preview.CaptureFrameCommand}" ToolTip="{StaticResource Editor.Monitor.CapturarQuadro}">
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE722;" />
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Monitor.TelaCheia}" Style="{StaticResource Editor.Controle}"
                                    IsEnabled="{Binding Preview.HasContent, FallbackValue=False}" Click="TelaCheia_Click"
                                    ToolTip="{StaticResource Editor.Monitor.TelaCheia}">
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE740;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Divisor horizontal entre a área central e a parte inferior -->
        <GridSplitter x:Name="DivisorCentral" Grid.Row="2" Height="3" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource Med.Background}" />

        <!-- 5 e 6. Ferramentas (E) e Linha do tempo (D) -->
        <Grid x:Name="AreaInferior" Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="160" />
            </Grid.RowDefinitions>

            <!-- Painel E: Ferramentas da linha do tempo -->
            <Border Grid.Row="0" Style="{StaticResource Editor.Painel}" Height="40" Margin="1,1,1,0">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.AdicionarMidia}" Style="{StaticResource Editor.Controle}"
                                Command="{Binding Timeline.AddSelectedMediaCommand}" ToolTip="{StaticResource Editor.Ferramenta.AdicionarMidia}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE710;" />
                        </Button>
                        <Button x:Name="BotaoAdicionarTrilha" AutomationProperties.Name="{StaticResource Editor.Ferramenta.AdicionarTrilha}" Style="{StaticResource Editor.Controle}"
                                IsEnabled="{Binding Timeline.HasSession}" Click="AdicionarTrilha_Click" ToolTip="{StaticResource Editor.Ferramenta.AdicionarTrilha}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE8A5;" />
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE70D;" FontSize="9" Margin="3,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{StaticResource Editor.Timeline.TrilhaVideo}" Command="{Binding Timeline.AddTrackCommand}" CommandParameter="{x:Static model:TrackKind.Video}" />
                                    <MenuItem Header="{StaticResource Editor.Timeline.TrilhaAudio}" Command="{Binding Timeline.AddTrackCommand}" CommandParameter="{x:Static model:TrackKind.Audio}" />
                                    <MenuItem Header="{StaticResource Editor.Timeline.TrilhaImagem}" Command="{Binding Timeline.AddTrackCommand}" CommandParameter="{x:Static model:TrackKind.Image}" />
                                    <MenuItem Header="{StaticResource Editor.Timeline.TrilhaTexto}" Command="{Binding Timeline.AddTrackCommand}" CommandParameter="{x:Static model:TrackKind.Text}" />
                                    <MenuItem Header="{StaticResource Editor.Timeline.TrilhaLegenda}" Command="{Binding Timeline.AddTrackCommand}" CommandParameter="{x:Static model:TrackKind.Subtitle}" />
                                    <MenuItem Header="{StaticResource Editor.Timeline.TrilhaEfeitos}" Command="{Binding Timeline.AddTrackCommand}" CommandParameter="{x:Static model:TrackKind.Effect}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Rectangle Width="1" Height="20" Margin="6,0" Fill="{DynamicResource Med.Border}" />
                        <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.Dividir}" Style="{StaticResource Editor.Controle}"
                                Command="{Binding Timeline.SplitCommand}" ToolTip="{StaticResource Editor.Ferramenta.Dividir}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE8C6;" />
                        </Button>
                        <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.Excluir}" Style="{StaticResource Editor.Controle}"
                                Command="{Binding Timeline.DeleteCommand}" ToolTip="{StaticResource Editor.Ferramenta.Excluir}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE74D;" />
                        </Button>
                        <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.ExcluirRipple}" Style="{StaticResource Editor.Controle}"
                                Command="{Binding Timeline.RippleDeleteCommand}" ToolTip="{StaticResource Editor.Ferramenta.ExcluirRipple}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE8BB;" />
                        </Button>
                        <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.Marcador}" Style="{StaticResource Editor.Controle}"
                                Command="{Binding Timeline.AddMarkerCommand}" ToolTip="{StaticResource Editor.Ferramenta.Marcador}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE7C1;" />
                        </Button>
                        <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.Mixer}" Style="{StaticResource Editor.Controle}"
                                Click="Mixer_Click" ToolTip="{StaticResource Editor.Ferramenta.Mixer}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE9E9;" />
                        </Button>
                        <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.EditorLegendas}" Style="{StaticResource Editor.Controle}"
                                Click="EditorLegendas_Click" IsEnabled="{Binding Timeline.HasSession}" ToolTip="{StaticResource Editor.Ferramenta.EditorLegendas}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xED1E;" />
                        </Button>
                        <Rectangle Width="1" Height="20" Margin="6,0" Fill="{DynamicResource Med.Border}" />
                        <ToggleButton AutomationProperties.Name="{StaticResource Editor.Ferramenta.Ima}" Style="{StaticResource Editor.Alternar}"
                                      IsChecked="{Binding Timeline.SnapEnabled}" ToolTip="{StaticResource Editor.Ferramenta.Ima}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE71B;" />
                        </ToggleButton>
                        <ToggleButton AutomationProperties.Name="{StaticResource Editor.Ferramenta.Ripple}" Style="{StaticResource Editor.Alternar}"
                                      IsChecked="{Binding Timeline.RippleEnabled}" ToolTip="{StaticResource Editor.Ferramenta.Ripple}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE8AB;" />
                        </ToggleButton>
                        <TextBlock Text="{Binding Timeline.SelectionSummary}" Style="{StaticResource Med.MutedText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.AfastarZoom}" Style="{StaticResource Editor.Controle}"
                                Command="{Binding Timeline.ZoomOutCommand}" ToolTip="{StaticResource Editor.Ferramenta.AfastarZoom}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE71F;" />
                        </Button>
                        <Slider Width="140" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                AutomationProperties.Name="{StaticResource Editor.Ferramenta.Zoom}"
                                Value="{Binding Timeline.ZoomSlider}" ToolTip="{Binding Timeline.ZoomLabel}" />
                        <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.AproximarZoom}" Style="{StaticResource Editor.Controle}"
                                Command="{Binding Timeline.ZoomInCommand}" ToolTip="{StaticResource Editor.Ferramenta.AproximarZoom}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE71E;" />
                        </Button>
                        <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.AjustarZoom}" Style="{StaticResource Editor.Controle}"
                                Command="{Binding Timeline.ZoomToFitCommand}" ToolTip="{StaticResource Editor.Ferramenta.AjustarZoom}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE9A6;" />
                        </Button>
                        <TextBlock Text="{Binding Timeline.ZoomLabel}" Style="{StaticResource Med.MutedText}" Width="64" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Painel D: Linha do tempo -->
            <Border Grid.Row="1" Style="{StaticResource Editor.Painel}" Margin="1" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="176" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource Med.Panel}"
                            BorderBrush="{DynamicResource Med.Border}" BorderThickness="0,0,1,1">
                        <TextBlock Text="{Binding Timeline.TimeDisplay}" FontFamily="Consolas" FontSize="11"
                                   Foreground="{DynamicResource Med.TextMuted}" VerticalAlignment="Center" Margin="8,0" />
                    </Border>

                    <ctl:TimelineRuler x:Name="Regua" Grid.Row="0" Grid.Column="1" ViewModel="{Binding Timeline}"
                                       AutomationProperties.Name="{StaticResource Editor.Timeline.Regua}">
                        <ctl:TimelineRuler.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{StaticResource Editor.Timeline.RenomearMarcador}" Click="RenomearMarcador_Click" />
                                <MenuItem Header="{StaticResource Editor.Timeline.RemoverMarcador}" Click="RemoverMarcador_Click" />
                            </ContextMenu>
                        </ctl:TimelineRuler.ContextMenu>
                    </ctl:TimelineRuler>

                    <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="176" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ItemsControl Grid.Column="0" ItemsSource="{Binding Timeline.Tracks}" Focusable="False"
                                          AutomationProperties.Name="{StaticResource Editor.Timeline.Trilhas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type tl:TrackHeaderViewModel}">
                                        <Border Height="{Binding Height}" Background="{DynamicResource Med.Panel}"
                                                BorderBrush="{DynamicResource Med.Border}" BorderThickness="0,0,1,1"
                                                AutomationProperties.Name="{Binding Name}">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{StaticResource Editor.Timeline.RenomearTrilha}" Command="{Binding RenameCommand}" />
                                                    <MenuItem Header="{StaticResource Editor.Timeline.RemoverTrilha}" Command="{Binding RemoveCommand}" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid Margin="6,0,2,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Med.Icon}" Text="{Binding KindGlyph}" FontSize="12"
                                                           Foreground="{DynamicResource Med.TextMuted}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Margin="6,0,2,0"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="2" Style="{StaticResource Editor.TrilhaBotao}" Command="{Binding ToggleHiddenCommand}"
                                                        AutomationProperties.Name="{Binding HideToolTip}" ToolTip="{Binding HideToolTip}"
                                                        Visibility="{Binding CanHide, Converter={StaticResource Editor.BoolVisivel}}">
                                                    <TextBlock Style="{StaticResource Med.Icon}" Text="{Binding HideGlyph}" FontSize="12" />
                                                </Button>
                                                <Button Grid.Column="3" Style="{StaticResource Editor.TrilhaBotao}" Command="{Binding ToggleMutedCommand}"
                                                        AutomationProperties.Name="{Binding MuteToolTip}" ToolTip="{Binding MuteToolTip}"
                                                        Visibility="{Binding CanMute, Converter={StaticResource Editor.BoolVisivel}}">
                                                    <TextBlock Style="{StaticResource Med.Icon}" Text="{Binding MuteGlyph}" FontSize="12" />
                                                </Button>
                                                <Button Grid.Column="4" Style="{StaticResource Editor.TrilhaBotao}" Command="{Binding ToggleLockCommand}"
                                                        AutomationProperties.Name="{Binding LockToolTip}" ToolTip="{Binding LockToolTip}">
                                                    <TextBlock Style="{StaticResource Med.Icon}" Text="{Binding LockGlyph}" FontSize="12" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ctl:TimelineControl x:Name="LinhaDoTempo" Grid.Column="1" ViewModel="{Binding Timeline}"
                                                 Height="{Binding Timeline.TracksHeight}" VerticalAlignment="Top"
                                                 AutomationProperties.Name="{StaticResource Editor.Timeline.Nome}">
                                <ctl:TimelineControl.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{StaticResource Editor.Timeline.Dividir}" ctl:ShortcutText.Action="linha.dividir" Command="{Binding Timeline.SplitCommand}" />
                                        <Separator />
                                        <MenuItem Header="{StaticResource Editor.Timeline.Recortar}" ctl:ShortcutText.Action="linha.recortar" Command="{Binding Timeline.CutCommand}" />
                                        <MenuItem Header="{StaticResource Editor.Timeline.Copiar}" ctl:ShortcutText.Action="linha.copiar" Command="{Binding Timeline.CopyCommand}" />
                                        <MenuItem Header="{StaticResource Editor.Timeline.Colar}" ctl:ShortcutText.Action="linha.colar" Command="{Binding Timeline.PasteCommand}" />
                                        <MenuItem Header="{StaticResource Editor.Timeline.Duplicar}" ctl:ShortcutText.Action="linha.duplicar" Command="{Binding Timeline.DuplicateCommand}" />
                                        <Separator />
                                        <MenuItem Header="{StaticResource Editor.Timeline.Velocidade}" Command="{Binding Timeline.SetSpeedCommand}" />
                                        <MenuItem Header="{StaticResource Editor.Timeline.CorClipe}">
                                            <MenuItem Header="{StaticResource Editor.Timeline.CorAutomatica}" Command="{Binding Timeline.SetClipColorCommand}" CommandParameter="" />
                                            <Separator />
                                            <MenuItem Header="{StaticResource Editor.Cor.Vermelho}" Command="{Binding Timeline.SetClipColorCommand}" CommandParameter="#C0474F">
                                                <MenuItem.Icon><Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#C0474F" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{StaticResource Editor.Cor.Laranja}" Command="{Binding Timeline.SetClipColorCommand}" CommandParameter="#D2693A">
                                                <MenuItem.Icon><Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#D2693A" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{StaticResource Editor.Cor.Amarelo}" Command="{Binding Timeline.SetClipColorCommand}" CommandParameter="#C9A23A">
                                                <MenuItem.Icon><Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#C9A23A" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{StaticResource Editor.Cor.Verde}" Command="{Binding Timeline.SetClipColorCommand}" CommandParameter="#3E9A55">
                                                <MenuItem.Icon><Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#3E9A55" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{StaticResource Editor.Cor.VerdeAgua}" Command="{Binding Timeline.SetClipColorCommand}" CommandParameter="#1F9C80">
                                                <MenuItem.Icon><Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#1F9C80" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{StaticResource Editor.Cor.Azul}" Command="{Binding Timeline.SetClipColorCommand}" CommandParameter="#2F7FA8">
                                                <MenuItem.Icon><Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#2F7FA8" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{StaticResource Editor.Cor.Indigo}" Command="{Binding Timeline.SetClipColorCommand}" CommandParameter="#5865C8">
                                                <MenuItem.Icon><Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#5865C8" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{StaticResource Editor.Cor.Roxo}" Command="{Binding Timeline.SetClipColorCommand}" CommandParameter="#8A5CD6">
                                                <MenuItem.Icon><Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#8A5CD6" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{StaticResource Editor.Cor.Cinza}" Command="{Binding Timeline.SetClipColorCommand}" CommandParameter="#6E6E78">
                                                <MenuItem.Icon><Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#6E6E78" /></MenuItem.Icon>
                                            </MenuItem>
                                        </MenuItem>
                                        <MenuItem Header="{StaticResource Editor.Timeline.Agrupar}" ctl:ShortcutText.Action="linha.agrupar" Command="{Binding Timeline.GroupCommand}" />
                                        <MenuItem Header="{StaticResource Editor.Timeline.Desagrupar}" ctl:ShortcutText.Action="linha.desagrupar" Command="{Binding Timeline.UngroupCommand}" />
                                        <MenuItem Header="{StaticResource Editor.Timeline.Vincular}" Command="{Binding Timeline.LinkCommand}" />
                                        <MenuItem Header="{StaticResource Editor.Timeline.Desvincular}" Command="{Binding Timeline.UnlinkCommand}" />
                                        <Separator />
                                        <MenuItem Header="{StaticResource Editor.Timeline.SelecionarTudo}" ctl:ShortcutText.Action="linha.selecionarTudo" Command="{Binding Timeline.SelectAllCommand}" />
                                        <MenuItem Header="{StaticResource Editor.Timeline.Excluir}" ctl:ShortcutText.Action="linha.excluir" Command="{Binding Timeline.DeleteCommand}" />
                                        <MenuItem Header="{StaticResource Editor.Timeline.ExcluirRipple}" ctl:ShortcutText.Action="linha.excluirFechando" Command="{Binding Timeline.RippleDeleteCommand}" />
                                    </ContextMenu>
                                </ctl:TimelineControl.ContextMenu>
                            </ctl:TimelineControl>
                        </Grid>
                    </ScrollViewer>

                    <ScrollBar Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Minimum="0"
                               AutomationProperties.Name="{StaticResource Editor.Timeline.Rolagem}"
                               Maximum="{Binding Timeline.MaxHorizontalOffset, Mode=OneWay}"
                               ViewportSize="{Binding Timeline.ViewportWidth, Mode=OneWay}"
                               LargeChange="{Binding Timeline.ViewportWidth, Mode=OneWay}" SmallChange="40"
                               Value="{Binding Timeline.HorizontalOffset}" />
                </Grid>
            </Border>
        </Grid>

            <GridSplitter x:Name="DivisorPropriedades" Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" Width="3" MinWidth="0" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Background="{DynamicResource Med.Background}" />

            <!-- Painel C: Propriedades (altura total, do topo até a linha do tempo) -->
            <Border x:Name="PainelPropriedades" Grid.Row="1" Grid.RowSpan="3" Grid.Column="2" Style="{StaticResource Editor.Painel}" Margin="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TabControl Grid.Row="1" Margin="6,6,6,6"
                                Background="{DynamicResource Med.Panel}"
                                BorderBrush="{DynamicResource Med.Border}">
                        <!-- Abas: ícone + texto em verde; a ativa fica preenchida e com um ponto vermelho -->
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                <Setter Property="Padding" Value="2" />
                                <Setter Property="Margin" Value="0,0,2,2" />
                                <Setter Property="HeaderTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <Grid>
                                                <Border x:Name="Fundo" CornerRadius="4" Padding="8,5" Background="Transparent">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="Icone" Style="{StaticResource Med.Icon}" FontSize="14"
                                                                   Foreground="{DynamicResource Med.Accent}"
                                                                   Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                                        <TextBlock x:Name="Rotulo" Text="{Binding}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Med.Accent}" />
                                                    </StackPanel>
                                                </Border>
                                                <Ellipse x:Name="Ponto" Width="9" Height="9" Fill="{DynamicResource Med.Danger}"
                                                         Stroke="{DynamicResource Med.Panel}" StrokeThickness="1.5"
                                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                                                         Visibility="Collapsed" IsHitTestVisible="False" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                                                    <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource Med.Accent}" />
                                                    <Setter TargetName="Icone" Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                                                    <Setter TargetName="Rotulo" Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                                                    <Setter TargetName="Rotulo" Property="FontWeight" Value="SemiBold" />
                                                    <Setter TargetName="Ponto" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.ItemContainerStyle>
                        <TabItem Tag="&#xE7C3;" Header="{StaticResource Editor.Propriedades.Projeto}" AutomationProperties.Name="{StaticResource Editor.Propriedades.InfoProjeto}" IsSelected="True">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                                <ItemsControl ItemsSource="{Binding ProjectInfoLines}" ItemTemplate="{StaticResource Editor.LinhaInfo}" />
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Tag="&#xE8B9;" Header="{StaticResource Editor.Propriedades.Midia}" AutomationProperties.Name="{StaticResource Editor.Propriedades.InfoMidia}">
                            <Grid>
                                <TextBlock Text="{StaticResource Editor.Propriedades.SelecioneMidia}"
                                           TextWrapping="Wrap" Margin="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Med.MutedText}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Library.HasSelection}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                                    <ScrollViewer.Style>
                                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Library.HasSelection}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ScrollViewer.Style>
                                    <ItemsControl ItemsSource="{Binding Library.SelectedItem.InfoLines}">
                                        <ItemsControl.ItemTemplate>
                                            <StaticResource ResourceKey="Editor.LinhaInfo" />
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                        <TabItem Tag="&#xE714;" Header="{StaticResource Editor.Propriedades.Video}" AutomationProperties.Name="{StaticResource Editor.Propriedades.Video}">
                            <panels:ClipVideoPanel DataContext="{Binding Inspector}" />
                        </TabItem>
                        <TabItem Tag="&#xE8D2;" Header="{StaticResource Editor.Propriedades.Texto}" AutomationProperties.Name="{StaticResource Editor.Propriedades.Texto}">
                            <panels:ClipTextPanel DataContext="{Binding TextInspector}" />
                        </TabItem>
                        <TabItem Tag="&#xE81E;" Header="{StaticResource Editor.Propriedades.Composicao}" AutomationProperties.Name="{StaticResource Editor.Propriedades.Composicao}">
                            <panels:ClipCompositionPanel DataContext="{Binding CompositionInspector}" />
                        </TabItem>
                        <TabItem Tag="&#xE99A;" Header="{StaticResource Editor.Propriedades.IA}" AutomationProperties.Name="Inteligência artificial">
                            <panels:ClipAiPanel DataContext="{Binding AiInspector}" />
                        </TabItem>
                        <TabItem Tag="&#xE8D6;" Header="{StaticResource Editor.Propriedades.Audio}" AutomationProperties.Name="{StaticResource Editor.Propriedades.Audio}">
                            <panels:ClipAudioPanel DataContext="{Binding AudioInspector}" />
                        </TabItem>
                        <TabItem Tag="&#xE706;" Header="{StaticResource Editor.Propriedades.Efeitos}" AutomationProperties.Name="{StaticResource Editor.Propriedades.Efeitos}">
                            <panels:ClipEffectsPanel Mode="Effects" DataContext="{Binding Inspector}" />
                        </TabItem>
                        <TabItem Tag="&#xE790;" Header="{StaticResource Editor.Propriedades.Cor}" AutomationProperties.Name="{StaticResource Editor.Propriedades.Cor}">
                            <panels:ClipEffectsPanel Mode="Color" DataContext="{Binding Inspector}" />
                        </TabItem>
                        <TabItem Tag="&#xE81C;" Header="{StaticResource Editor.Propriedades.Historico}" AutomationProperties.Name="{StaticResource Editor.Propriedades.Historico}">
                            <ListBox ItemsSource="{Binding HistoryItems}" Background="Transparent" BorderThickness="0"
                                     AutomationProperties.Name="{StaticResource Editor.Propriedades.Historico}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Med.ToolbarButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Padding="8,4" AutomationProperties.Name="{Binding Description}"
                                                Command="{Binding DataContext.GoToHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Med.Text}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUndone}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Med.TextMuted}" />
                                                                    <Setter Property="FontStyle" Value="Italic" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Med.Accent}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding Time}" Style="{StaticResource Med.MutedText}" Margin="8,0,0,0" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
    </Grid>
</UserControl>
