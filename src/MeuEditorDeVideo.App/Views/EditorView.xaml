<UserControl x:Class="MeuEditorDeVideo.App.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MeuEditorDeVideo.App.ViewModels"
             Background="{DynamicResource Med.Background}"
             Foreground="{DynamicResource Med.Text}">
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Editor.BoolToVis" />
        <!-- Botões da barra de ações e de controles -->
        <Style x:Key="Editor.Acao" TargetType="Button" BasedOn="{StaticResource Med.ToolbarButton}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="Editor.Controle" TargetType="Button" BasedOn="{StaticResource Med.ToolbarButton}">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <Style x:Key="Editor.Icone" TargetType="TextBlock" BasedOn="{StaticResource Med.Icon}">
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- Navegação vertical do painel A -->
        <ControlTemplate x:Key="Editor.NavModelo" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
        </ControlTemplate>

        <Style x:Key="Editor.NavBase" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Med.TextMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource Editor.NavModelo}" />
        </Style>

        <Style x:Key="Editor.Nav.Media" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Media}">
                    <Setter Property="Background" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Videos" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Videos}">
                    <Setter Property="Background" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Images" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Images}">
                    <Setter Property="Background" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Audio" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Audio}">
                    <Setter Property="Background" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Graphics" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Graphics}">
                    <Setter Property="Background" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Texts" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Texts}">
                    <Setter Property="Background" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Transitions" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Transitions}">
                    <Setter Property="Background" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Effects" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Effects}">
                    <Setter Property="Background" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Color" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Color}">
                    <Setter Property="Background" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.AI" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.AI}">
                    <Setter Property="Background" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Placeholder da pesquisa: visível somente com o campo vazio -->
        <Style x:Key="Editor.Placeholder" TargetType="TextBlock" BasedOn="{StaticResource Med.MutedText}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=CampoPesquisa}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="300" MinHeight="200" />
        </Grid.RowDefinitions>

        <!-- 1. Menu -->
        <Menu Grid.Row="0">
            <MenuItem Header="{StaticResource Editor.Menu.Arquivo}">
                <MenuItem Header="{StaticResource Editor.Menu.NovoProjeto}" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="{StaticResource Editor.Menu.Abrir}" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="{StaticResource Editor.Menu.Salvar}" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="{StaticResource Editor.Menu.SalvarComo}" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                <MenuItem Header="{StaticResource Editor.Menu.CopiaSeguranca}" Command="{Binding CreateBackupCommand}" />
                <Separator />
                <MenuItem Header="{StaticResource Editor.Menu.Exportar}" Command="{Binding ExportCommand}" />
                <Separator />
                <MenuItem Header="{StaticResource Editor.Menu.Inicio}" Command="{Binding GoHomeCommand}" />
            </MenuItem>
            <MenuItem Header="{StaticResource Editor.Menu.Editar}">
                <MenuItem Header="{StaticResource Editor.Menu.Desfazer}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" ToolTip="{Binding UndoToolTip}" />
                <MenuItem Header="{StaticResource Editor.Menu.Refazer}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" ToolTip="{Binding RedoToolTip}" />
            </MenuItem>
            <MenuItem Header="{StaticResource Editor.Menu.Visualizar}">
                <MenuItem Header="{StaticResource Editor.Menu.AlternarTema}" Command="{Binding ToggleThemeCommand}" />
            </MenuItem>
            <MenuItem Header="{StaticResource Editor.Menu.Projeto}">
                <MenuItem Header="{StaticResource Editor.Menu.EmpacotarMidias}" Command="{Binding PackageMediaCommand}" />
                <MenuItem Header="{StaticResource Editor.Menu.MidiasAusentes}" Command="{Binding ShowMissingMediaCommand}" />
            </MenuItem>
            <MenuItem Header="{StaticResource Editor.Menu.Ferramentas}" />
            <MenuItem Header="{StaticResource Editor.Menu.Ajuda}" />
        </Menu>

        <!-- 2. Barra de ações -->
        <Border Grid.Row="1" Background="{DynamicResource Med.Panel}"
                BorderBrush="{DynamicResource Med.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button AutomationProperties.Name="{StaticResource Editor.Acao.Inicio}" Style="{StaticResource Editor.Acao}" Command="{Binding GoHomeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE80F;" />
                            <TextBlock Text="{StaticResource Editor.Acao.Inicio}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="{StaticResource Editor.Acao.Abrir}" Style="{StaticResource Editor.Acao}" Command="{Binding OpenCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8E5;" />
                            <TextBlock Text="{StaticResource Editor.Acao.Abrir}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="{StaticResource Editor.Acao.Salvar}" Style="{StaticResource Editor.Acao}" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE74E;" />
                            <TextBlock Text="{StaticResource Editor.Acao.Salvar}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{DynamicResource Med.Border}" Margin="8,10" />

                    <Button AutomationProperties.Name="{StaticResource Editor.Acao.Desfazer}" Style="{StaticResource Editor.Acao}" Command="{Binding UndoCommand}" ToolTip="{Binding UndoToolTip}" ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE7A7;" />
                            <TextBlock Text="{StaticResource Editor.Acao.Desfazer}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="{StaticResource Editor.Acao.Refazer}" Style="{StaticResource Editor.Acao}" Command="{Binding RedoCommand}" ToolTip="{Binding RedoToolTip}" ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE7A6;" />
                            <TextBlock Text="{StaticResource Editor.Acao.Refazer}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{DynamicResource Med.Border}" Margin="8,10" />

                    <Button AutomationProperties.Name="{StaticResource Editor.Acao.ImportarMidia}" Style="{StaticResource Editor.Acao}" Command="{Binding ImportMediaCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8B5;" />
                            <TextBlock Text="{StaticResource Editor.Acao.ImportarMidia}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProjectName}" Foreground="{DynamicResource Med.Text}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{StaticResource Editor.NaoSalvo}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Med.Accent}"
                               Visibility="{Binding IsDirty, Converter={StaticResource Editor.BoolToVis}}" />
                    <TextBlock Text="{Binding ProjectSummary}" Style="{StaticResource Med.MutedText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <Button AutomationProperties.Name="{StaticResource Editor.MidiasAusentes}" Command="{Binding ShowMissingMediaCommand}"
                            Margin="12,0,0,0" Padding="8,2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Editor.Acao}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MissingMediaCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Med.Danger}" />
                            <TextBlock Margin="6,0,0,0" Foreground="{DynamicResource Med.Danger}">
                                <Run Text="{Binding MissingMediaCount, Mode=OneWay}" /><Run Text=" " /><Run Text="{StaticResource Editor.MidiasAusentesSufixo}" />
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button AutomationProperties.Name="{StaticResource Editor.Acao.AlternarTema}" Style="{StaticResource Editor.Acao}" Command="{Binding ToggleThemeCommand}"
                            ToolTip="{StaticResource Editor.Acao.AlternarTema}" ToolTipService.ShowOnDisabled="True">
                        <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE793;" />
                    </Button>
                    <Button AutomationProperties.Name="{StaticResource Editor.Acao.Exportar}" Style="{StaticResource Med.AccentButton}" Command="{Binding ExportCommand}"
                            Margin="8,0,0,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE898;" />
                            <TextBlock Text="{StaticResource Editor.Acao.Exportar}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Área central: Biblioteca | Monitor | Propriedades -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="320" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- Painel A: Biblioteca -->
            <Border Grid.Column="0" Style="{StaticResource Med.PanelBorder}" Margin="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,6">
                        <StackPanel>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Midias}" Style="{StaticResource Editor.Nav.Media}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Media}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8F1;" Width="20" TextAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Midias}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Videos}" Style="{StaticResource Editor.Nav.Videos}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Videos}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE714;" Width="20" TextAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Videos}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Imagens}" Style="{StaticResource Editor.Nav.Images}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Images}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8B9;" Width="20" TextAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Imagens}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Audios}" Style="{StaticResource Editor.Nav.Audio}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Audio}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8D6;" Width="20" TextAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Audios}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.ElementosGraficos}" Style="{StaticResource Editor.Nav.Graphics}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Graphics}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8F4;" Width="20" TextAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.ElementosGraficos}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Textos}" Style="{StaticResource Editor.Nav.Texts}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Texts}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8D2;" Width="20" TextAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Textos}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Transicoes}" Style="{StaticResource Editor.Nav.Transitions}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Transitions}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8AB;" Width="20" TextAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Transicoes}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Efeitos}" Style="{StaticResource Editor.Nav.Effects}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Effects}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE706;" Width="20" TextAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Efeitos}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Cor}" Style="{StaticResource Editor.Nav.Color}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Color}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE790;" Width="20" TextAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Cor}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.IA}" Style="{StaticResource Editor.Nav.AI}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.AI}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE99A;" Width="20" TextAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.IA}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Column="1" Margin="0,8,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Button AutomationProperties.Name="{StaticResource Editor.Acao.ImportarMidia}" Style="{StaticResource Editor.Acao}" Command="{Binding ImportMediaCommand}"
                                    HorizontalAlignment="Left" Margin="0" Padding="8,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8B5;" FontSize="14" />
                                    <TextBlock Text="{StaticResource Editor.Acao.ImportarMidia}" Margin="6,0,0,0" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <Grid Margin="0,8,0,0">
                                <TextBox x:Name="CampoPesquisa"
                                         AutomationProperties.Name="{StaticResource Editor.Biblioteca.Pesquisar}"
                                         Background="{DynamicResource Med.PanelAlt}"
                                         Foreground="{DynamicResource Med.Text}"
                                         BorderBrush="{DynamicResource Med.Border}"
                                         CaretBrush="{DynamicResource Med.Text}"
                                         Padding="6,4" VerticalContentAlignment="Center" />
                                <TextBlock Text="{StaticResource Editor.Biblioteca.Pesquisar}"
                                           Style="{StaticResource Editor.Placeholder}" />
                            </Grid>
                        </StackPanel>

                        <Border Grid.Row="1" Margin="0,8,0,0" Background="{DynamicResource Med.PanelAlt}" CornerRadius="6">
                            <TextBlock Text="{StaticResource Editor.Biblioteca.Vazia}"
                                       Style="{StaticResource Med.MutedText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Background="{DynamicResource Med.Background}" />

            <!-- Painel B: Monitor -->
            <Border Grid.Column="2" Style="{StaticResource Med.PanelBorder}" Margin="4">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource Med.MonitorBackground}" CornerRadius="4" ClipToBounds="True">
                        <Viewbox Stretch="Uniform">
                            <Border Width="1920" Height="1080" Background="{DynamicResource Med.MonitorBackground}">
                                <TextBlock Text="{StaticResource Editor.Monitor.PreVisualizacao}"
                                           Style="{StaticResource Med.MutedText}" FontSize="48"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Viewbox>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button AutomationProperties.Name="{StaticResource Editor.Monitor.IrInicio}" Style="{StaticResource Editor.Controle}" IsEnabled="False" ToolTip="{StaticResource Editor.Monitor.IrInicio}">
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE892;" />
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Monitor.Retroceder}" Style="{StaticResource Editor.Controle}" IsEnabled="False" ToolTip="{StaticResource Editor.Monitor.Retroceder}">
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xEB9E;" />
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Monitor.ReproduzirPausar}" Style="{StaticResource Editor.Controle}" Command="{Binding PlayPauseCommand}" ToolTip="{StaticResource Editor.Monitor.ReproduzirPausar}">
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE768;" />
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Monitor.Avancar}" Style="{StaticResource Editor.Controle}" IsEnabled="False" ToolTip="{StaticResource Editor.Monitor.Avancar}">
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xEB9D;" />
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Monitor.IrFim}" Style="{StaticResource Editor.Controle}" IsEnabled="False" ToolTip="{StaticResource Editor.Monitor.IrFim}">
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE893;" />
                            </Button>

                            <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE767;" FontSize="14" Margin="10,0,6,0"
                                       ToolTip="{StaticResource Editor.Monitor.Volume}" />
                            <Slider Width="90" Minimum="0" Maximum="100" Value="80" IsEnabled="False"
                                    VerticalAlignment="Center" ToolTip="{StaticResource Editor.Monitor.Volume}"
                                    ToolTipService.ShowOnDisabled="True" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding TimeDisplay}"
                                   FontFamily="Consolas" FontSize="13"
                                   Foreground="{DynamicResource Med.Text}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0" />

                        <Button AutomationProperties.Name="{StaticResource Editor.Monitor.TelaCheia}" Grid.Column="2" Style="{StaticResource Editor.Controle}" IsEnabled="False"
                                ToolTip="{StaticResource Editor.Monitor.TelaCheia}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE740;" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Background="{DynamicResource Med.Background}" />

            <!-- Painel C: Propriedades -->
            <Border Grid.Column="4" Style="{StaticResource Med.PanelBorder}" Margin="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{StaticResource Editor.Propriedades.Titulo}"
                               Style="{StaticResource Med.SectionTitle}" Margin="12,10,12,8" />

                    <TabControl Grid.Row="1" Margin="8,0,8,8"
                                Background="{DynamicResource Med.Panel}"
                                BorderBrush="{DynamicResource Med.Border}">
                        <TabItem Header="{StaticResource Editor.Propriedades.Video}">
                            <TextBlock Text="{StaticResource Editor.Propriedades.Selecione}"
                                       Style="{StaticResource Med.MutedText}" TextWrapping="Wrap"
                                       Margin="12" />
                        </TabItem>
                        <TabItem Header="{StaticResource Editor.Propriedades.Audio}">
                            <TextBlock Text="{StaticResource Editor.Propriedades.Selecione}"
                                       Style="{StaticResource Med.MutedText}" TextWrapping="Wrap"
                                       Margin="12" />
                        </TabItem>
                        <TabItem Header="{StaticResource Editor.Propriedades.Efeitos}">
                            <TextBlock Text="{StaticResource Editor.Propriedades.Selecione}"
                                       Style="{StaticResource Med.MutedText}" TextWrapping="Wrap"
                                       Margin="12" />
                        </TabItem>
                        <TabItem Header="{StaticResource Editor.Propriedades.Historico}" AutomationProperties.Name="{StaticResource Editor.Propriedades.Historico}">
                            <ListBox ItemsSource="{Binding HistoryItems}" Background="Transparent" BorderThickness="0"
                                     AutomationProperties.Name="{StaticResource Editor.Propriedades.Historico}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Med.ToolbarButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Padding="8,4" AutomationProperties.Name="{Binding Description}"
                                                Command="{Binding DataContext.GoToHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Med.Text}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUndone}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Med.TextMuted}" />
                                                                    <Setter Property="FontStyle" Value="Italic" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Med.Accent}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding Time}" Style="{StaticResource Med.MutedText}" Margin="8,0,0,0" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Divisor horizontal entre a área central e a parte inferior -->
        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource Med.Background}" />

        <!-- 5 e 6. Ferramentas (E) e Linha do tempo (D) -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="160" />
            </Grid.RowDefinitions>

            <!-- Painel E: Ferramentas -->
            <Border Grid.Row="0" Style="{StaticResource Med.PanelBorder}" Height="40" Margin="4,4,4,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.Selecao}" Style="{StaticResource Editor.Controle}" IsEnabled="False" ToolTip="{StaticResource Editor.Ferramenta.Selecao}">
                        <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE8B0;" />
                    </Button>
                    <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.Corte}" Style="{StaticResource Editor.Controle}" IsEnabled="False" ToolTip="{StaticResource Editor.Ferramenta.Corte}">
                        <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE8C6;" />
                    </Button>
                    <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.Divisao}" Style="{StaticResource Editor.Controle}" IsEnabled="False" ToolTip="{StaticResource Editor.Ferramenta.Divisao}">
                        <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE8C6;" />
                    </Button>
                    <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.Texto}" Style="{StaticResource Editor.Controle}" IsEnabled="False" ToolTip="{StaticResource Editor.Ferramenta.Texto}">
                        <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE8D2;" />
                    </Button>
                    <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.Mascara}" Style="{StaticResource Editor.Controle}" IsEnabled="False" ToolTip="{StaticResource Editor.Ferramenta.Mascara}">
                        <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE7B3;" />
                    </Button>
                    <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.Zoom}" Style="{StaticResource Editor.Controle}" IsEnabled="False" ToolTip="{StaticResource Editor.Ferramenta.Zoom}">
                        <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE71E;" />
                    </Button>
                    <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.Movimentacao}" Style="{StaticResource Editor.Controle}" IsEnabled="False" ToolTip="{StaticResource Editor.Ferramenta.Movimentacao}">
                        <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE7C2;" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Painel D: Linha do tempo (estrutura estática) -->
            <Border Grid.Row="1" Style="{StaticResource Med.PanelBorder}" Margin="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Régua -->
                    <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource Med.Panel}"
                            BorderBrush="{DynamicResource Med.Border}" BorderThickness="0,0,1,1" />
                    <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource Med.Panel}"
                            BorderBrush="{DynamicResource Med.Border}" BorderThickness="0,0,0,1">
                        <UniformGrid Columns="7">
                            <TextBlock Text="{StaticResource Editor.Timeline.Marca00}" Style="{StaticResource Med.MutedText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{StaticResource Editor.Timeline.Marca05}" Style="{StaticResource Med.MutedText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{StaticResource Editor.Timeline.Marca10}" Style="{StaticResource Med.MutedText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{StaticResource Editor.Timeline.Marca15}" Style="{StaticResource Med.MutedText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{StaticResource Editor.Timeline.Marca20}" Style="{StaticResource Med.MutedText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{StaticResource Editor.Timeline.Marca25}" Style="{StaticResource Med.MutedText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{StaticResource Editor.Timeline.Marca30}" Style="{StaticResource Med.MutedText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </UniformGrid>
                    </Border>

                    <!-- Trilha 1: Vídeo 1 -->
                    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource Med.Panel}"
                            BorderBrush="{DynamicResource Med.Border}" BorderThickness="0,0,1,1">
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{StaticResource Editor.Timeline.Video1}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Med.Icon}" Text="&#xE7B3;" FontSize="13" Margin="6,0" ToolTip="{StaticResource Editor.Timeline.Visivel}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Med.Icon}" Text="&#xE767;" FontSize="13" Margin="6,0" ToolTip="{StaticResource Editor.Timeline.Silenciar}" />
                            <TextBlock Grid.Column="3" Style="{StaticResource Med.Icon}" Text="&#xE72E;" FontSize="13" Margin="6,0" ToolTip="{StaticResource Editor.Timeline.Bloquear}" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Med.PanelAlt}"
                            BorderBrush="{DynamicResource Med.Border}" BorderThickness="0,0,0,1" />

                    <!-- Trilha 2: Vídeo 2 -->
                    <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource Med.Panel}"
                            BorderBrush="{DynamicResource Med.Border}" BorderThickness="0,0,1,1">
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{StaticResource Editor.Timeline.Video2}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Med.Icon}" Text="&#xE7B3;" FontSize="13" Margin="6,0" ToolTip="{StaticResource Editor.Timeline.Visivel}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Med.Icon}" Text="&#xE767;" FontSize="13" Margin="6,0" ToolTip="{StaticResource Editor.Timeline.Silenciar}" />
                            <TextBlock Grid.Column="3" Style="{StaticResource Med.Icon}" Text="&#xE72E;" FontSize="13" Margin="6,0" ToolTip="{StaticResource Editor.Timeline.Bloquear}" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource Med.PanelAlt}"
                            BorderBrush="{DynamicResource Med.Border}" BorderThickness="0,0,0,1" />

                    <!-- Trilha 3: Áudio 1 -->
                    <Border Grid.Row="3" Grid.Column="0" Background="{DynamicResource Med.Panel}"
                            BorderBrush="{DynamicResource Med.Border}" BorderThickness="0,0,1,1">
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{StaticResource Editor.Timeline.Audio1}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Med.Icon}" Text="&#xE7B3;" FontSize="13" Margin="6,0" ToolTip="{StaticResource Editor.Timeline.Visivel}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Med.Icon}" Text="&#xE767;" FontSize="13" Margin="6,0" ToolTip="{StaticResource Editor.Timeline.Silenciar}" />
                            <TextBlock Grid.Column="3" Style="{StaticResource Med.Icon}" Text="&#xE72E;" FontSize="13" Margin="6,0" ToolTip="{StaticResource Editor.Timeline.Bloquear}" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" Background="{DynamicResource Med.PanelAlt}"
                            BorderBrush="{DynamicResource Med.Border}" BorderThickness="0,0,0,1" />

                    <!-- Trilha 4: Texto 1 -->
                    <Border Grid.Row="4" Grid.Column="0" Background="{DynamicResource Med.Panel}"
                            BorderBrush="{DynamicResource Med.Border}" BorderThickness="0,0,1,0">
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{StaticResource Editor.Timeline.Texto1}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Med.Icon}" Text="&#xE7B3;" FontSize="13" Margin="6,0" ToolTip="{StaticResource Editor.Timeline.Visivel}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Med.Icon}" Text="&#xE767;" FontSize="13" Margin="6,0" ToolTip="{StaticResource Editor.Timeline.Silenciar}" />
                            <TextBlock Grid.Column="3" Style="{StaticResource Med.Icon}" Text="&#xE72E;" FontSize="13" Margin="6,0" ToolTip="{StaticResource Editor.Timeline.Bloquear}" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="1" Background="{DynamicResource Med.PanelAlt}" />

                    <!-- Cursor (playhead) em x=0 da área de trilhas -->
                    <Rectangle Grid.Row="0" Grid.RowSpan="5" Grid.Column="1" Width="2"
                               HorizontalAlignment="Left" Fill="{DynamicResource Med.Playhead}"
                               IsHitTestVisible="False" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
