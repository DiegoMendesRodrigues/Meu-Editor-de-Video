<UserControl x:Class="MeuEditorDeVideo.App.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MeuEditorDeVideo.App.ViewModels"
             xmlns:media="clr-namespace:MeuEditorDeVideo.App.ViewModels.Media"
             xmlns:tl="clr-namespace:MeuEditorDeVideo.App.ViewModels.Timeline"
             xmlns:ctl="clr-namespace:MeuEditorDeVideo.App.Controls"
             xmlns:panels="clr-namespace:MeuEditorDeVideo.App.Views.Panels"
             xmlns:model="clr-namespace:MeuEditorDeVideo.Domain.Model;assembly=MeuEditorDeVideo.Domain"
             Background="{DynamicResource Med.Background}"
             Foreground="{DynamicResource Med.Text}">
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ImportMediaCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Editor.BoolToVis" />
        <!-- Botões da barra de ações e de controles -->
        <Style x:Key="Editor.Acao" TargetType="Button" BasedOn="{StaticResource Med.ToolbarButton}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="Editor.Controle" TargetType="Button" BasedOn="{StaticResource Med.ToolbarButton}">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <Style x:Key="Editor.Icone" TargetType="TextBlock" BasedOn="{StaticResource Med.Icon}">
            <Setter Property="FontSize" Value="14" />
        </Style>

        <BooleanToVisibilityConverter x:Key="Editor.BoolVisivel" />

        <!-- Botão alternável da barra da linha do tempo (ímã, ripple) -->
        <Style x:Key="Editor.Alternar" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Med.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Fundo" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource Med.PanelHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource Med.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botões pequenos dos cabeçalhos de trilha -->
        <Style x:Key="Editor.TrilhaBotao" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Med.TextMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" Background="{TemplateBinding Background}" CornerRadius="3" Width="24" Height="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource Med.PanelHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Med.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navegação vertical do painel A -->
        <ControlTemplate x:Key="Editor.NavModelo" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
        </ControlTemplate>

        <Style x:Key="Editor.NavBase" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Med.TextMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource Editor.NavModelo}" />
        </Style>

        <Style x:Key="Editor.Nav.Media" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Media}">
                    <Setter Property="Background" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Videos" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Videos}">
                    <Setter Property="Background" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Images" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Images}">
                    <Setter Property="Background" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Audio" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Audio}">
                    <Setter Property="Background" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Graphics" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Graphics}">
                    <Setter Property="Background" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Texts" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Texts}">
                    <Setter Property="Background" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Transitions" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Transitions}">
                    <Setter Property="Background" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Effects" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Effects}">
                    <Setter Property="Background" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.Color" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.Color}">
                    <Setter Property="Background" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Editor.Nav.AI" TargetType="Button" BasedOn="{StaticResource Editor.NavBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:LibrarySection.AI}">
                    <Setter Property="Background" Value="{DynamicResource Med.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Placeholder da pesquisa: visível somente com o campo vazio -->
        <Style x:Key="Editor.Placeholder" TargetType="TextBlock" BasedOn="{StaticResource Med.MutedText}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=CampoPesquisa}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="300" MinHeight="200" />
        </Grid.RowDefinitions>

        <!-- 1. Menu -->
        <Menu Grid.Row="0">
            <MenuItem Header="{StaticResource Editor.Menu.Arquivo}">
                <MenuItem Header="{StaticResource Editor.Menu.NovoProjeto}" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="{StaticResource Editor.Menu.Abrir}" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="{StaticResource Editor.Menu.ImportarMidia}" Command="{Binding ImportMediaCommand}" InputGestureText="Ctrl+I" />
                <MenuItem Header="{StaticResource Editor.Menu.ImportarSequencia}" Command="{Binding ImportSequenceCommand}" />
                <Separator />
                <MenuItem Header="{StaticResource Editor.Menu.Salvar}" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="{StaticResource Editor.Menu.SalvarComo}" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                <MenuItem Header="{StaticResource Editor.Menu.CopiaSeguranca}" Command="{Binding CreateBackupCommand}" />
                <Separator />
                <MenuItem Header="{StaticResource Editor.Menu.Exportar}" Command="{Binding ExportCommand}" InputGestureText="Ctrl+E" />
                <MenuItem Header="{StaticResource Editor.Menu.FilaRenderizacao}" Command="{Binding ShowRenderQueueCommand}" />
                <Separator />
                <MenuItem Header="{StaticResource Editor.Menu.Inicio}" Command="{Binding GoHomeCommand}" />
            </MenuItem>
            <MenuItem Header="{StaticResource Editor.Menu.Editar}">
                <MenuItem Header="{StaticResource Editor.Menu.Desfazer}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" ToolTip="{Binding UndoToolTip}" />
                <MenuItem Header="{StaticResource Editor.Menu.Refazer}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" ToolTip="{Binding RedoToolTip}" />
            </MenuItem>
            <MenuItem Header="{StaticResource Editor.Menu.Visualizar}">
                <MenuItem Header="{StaticResource Editor.Menu.AlternarTema}" Command="{Binding ToggleThemeCommand}" />
            </MenuItem>
            <MenuItem Header="{StaticResource Editor.Menu.Projeto}">
                <MenuItem Header="{StaticResource Editor.Menu.EmpacotarMidias}" Command="{Binding PackageMediaCommand}" />
                <MenuItem Header="{StaticResource Editor.Menu.MidiasAusentes}" Command="{Binding ShowMissingMediaCommand}" />
            </MenuItem>
            <MenuItem Header="{StaticResource Editor.Menu.Ferramentas}" />
            <MenuItem Header="{StaticResource Editor.Menu.Ajuda}" />
        </Menu>

        <!-- 2. Barra de ações -->
        <Border Grid.Row="1" Background="{DynamicResource Med.Panel}"
                BorderBrush="{DynamicResource Med.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button AutomationProperties.Name="{StaticResource Editor.Acao.Inicio}" Style="{StaticResource Editor.Acao}" Command="{Binding GoHomeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE80F;" />
                            <TextBlock Text="{StaticResource Editor.Acao.Inicio}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="{StaticResource Editor.Acao.Abrir}" Style="{StaticResource Editor.Acao}" Command="{Binding OpenCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8E5;" />
                            <TextBlock Text="{StaticResource Editor.Acao.Abrir}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="{StaticResource Editor.Acao.Salvar}" Style="{StaticResource Editor.Acao}" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE74E;" />
                            <TextBlock Text="{StaticResource Editor.Acao.Salvar}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{DynamicResource Med.Border}" Margin="8,10" />

                    <Button AutomationProperties.Name="{StaticResource Editor.Acao.Desfazer}" Style="{StaticResource Editor.Acao}" Command="{Binding UndoCommand}" ToolTip="{Binding UndoToolTip}" ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE7A7;" />
                            <TextBlock Text="{StaticResource Editor.Acao.Desfazer}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="{StaticResource Editor.Acao.Refazer}" Style="{StaticResource Editor.Acao}" Command="{Binding RedoCommand}" ToolTip="{Binding RedoToolTip}" ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE7A6;" />
                            <TextBlock Text="{StaticResource Editor.Acao.Refazer}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{DynamicResource Med.Border}" Margin="8,10" />

                    <Button AutomationProperties.Name="{StaticResource Editor.Acao.ImportarMidia}" Style="{StaticResource Editor.Acao}" Command="{Binding ImportMediaCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8B5;" />
                            <TextBlock Text="{StaticResource Editor.Acao.ImportarMidia}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProjectName}" Foreground="{DynamicResource Med.Text}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{StaticResource Editor.NaoSalvo}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Med.Accent}"
                               Visibility="{Binding IsDirty, Converter={StaticResource Editor.BoolToVis}}" />
                    <TextBlock Text="{Binding ProjectSummary}" Style="{StaticResource Med.MutedText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <Button AutomationProperties.Name="{StaticResource Editor.MidiasAusentes}" Command="{Binding ShowMissingMediaCommand}"
                            Margin="12,0,0,0" Padding="8,2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Editor.Acao}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MissingMediaCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Med.Danger}" />
                            <TextBlock Margin="6,0,0,0" Foreground="{DynamicResource Med.Danger}">
                                <Run Text="{Binding MissingMediaCount, Mode=OneWay}" /><Run Text=" " /><Run Text="{StaticResource Editor.MidiasAusentesSufixo}" />
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button AutomationProperties.Name="{StaticResource Editor.Acao.AlternarTema}" Style="{StaticResource Editor.Acao}" Command="{Binding ToggleThemeCommand}"
                            ToolTip="{StaticResource Editor.Acao.AlternarTema}" ToolTipService.ShowOnDisabled="True">
                        <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE793;" />
                    </Button>
                    <Button AutomationProperties.Name="{StaticResource Editor.Acao.FilaRenderizacao}" Style="{StaticResource Editor.Acao}" Command="{Binding ShowRenderQueueCommand}"
                            ToolTip="{StaticResource Editor.Acao.FilaRenderizacao}" Margin="4,0,0,0">
                        <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE896;" />
                    </Button>
                    <Button AutomationProperties.Name="{StaticResource Editor.Acao.Exportar}" Style="{StaticResource Med.AccentButton}" Command="{Binding ExportCommand}"
                            Margin="8,0,0,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE898;" />
                            <TextBlock Text="{StaticResource Editor.Acao.Exportar}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Área central: Biblioteca | Monitor | Propriedades -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="320" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- Painel A: Biblioteca -->
            <Border Grid.Column="0" Style="{StaticResource Med.PanelBorder}" Margin="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,6">
                        <StackPanel>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Midias}" Style="{StaticResource Editor.Nav.Media}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Media}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8F1;" Width="20" TextAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Midias}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Videos}" Style="{StaticResource Editor.Nav.Videos}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Videos}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE714;" Width="20" TextAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Videos}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Imagens}" Style="{StaticResource Editor.Nav.Images}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Images}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8B9;" Width="20" TextAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Imagens}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Audios}" Style="{StaticResource Editor.Nav.Audio}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Audio}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8D6;" Width="20" TextAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Audios}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.ElementosGraficos}" Style="{StaticResource Editor.Nav.Graphics}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Graphics}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8F4;" Width="20" TextAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.ElementosGraficos}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Textos}" Style="{StaticResource Editor.Nav.Texts}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Texts}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8D2;" Width="20" TextAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Textos}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Transicoes}" Style="{StaticResource Editor.Nav.Transitions}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Transitions}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8AB;" Width="20" TextAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Transicoes}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Efeitos}" Style="{StaticResource Editor.Nav.Effects}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Effects}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE706;" Width="20" TextAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Efeitos}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.Cor}" Style="{StaticResource Editor.Nav.Color}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.Color}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE790;" Width="20" TextAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Cor}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Biblioteca.IA}" Style="{StaticResource Editor.Nav.AI}" Command="{Binding SelectSectionCommand}"
                                    CommandParameter="{x:Static vm:LibrarySection.AI}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE99A;" Width="20" TextAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.IA}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Column="1" Margin="0,8,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <Button AutomationProperties.Name="{StaticResource Editor.Acao.ImportarMidia}" Style="{StaticResource Editor.Acao}" Command="{Binding ImportMediaCommand}"
                                        HorizontalAlignment="Left" Margin="0" Padding="8,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE8B5;" FontSize="14" />
                                        <TextBlock Text="{StaticResource Editor.Acao.ImportarMidia}" Margin="6,0,0,0" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button AutomationProperties.Name="{StaticResource Editor.Acao.ImportarSequencia}"
                                        ToolTip="{StaticResource Editor.Acao.ImportarSequencia}"
                                        Style="{StaticResource Editor.Controle}" Command="{Binding ImportSequenceCommand}"
                                        Margin="6,0,0,0">
                                    <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE8B9;" />
                                </Button>
                            </StackPanel>

                            <StackPanel Margin="0,8,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMediaSection}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid>
                                    <TextBox x:Name="CampoPesquisa"
                                             AutomationProperties.Name="{StaticResource Editor.Biblioteca.Pesquisar}"
                                             Text="{Binding Library.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{DynamicResource Med.PanelAlt}"
                                             Foreground="{DynamicResource Med.Text}"
                                             BorderBrush="{DynamicResource Med.Border}"
                                             CaretBrush="{DynamicResource Med.Text}"
                                             Padding="6,4" VerticalContentAlignment="Center" />
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.Pesquisar}"
                                               Style="{StaticResource Editor.Placeholder}" />
                                </Grid>

                                <ComboBox AutomationProperties.Name="{StaticResource Editor.Biblioteca.Categoria}"
                                          ToolTip="{StaticResource Editor.Biblioteca.Categoria}"
                                          ItemsSource="{Binding Library.Categories}"
                                          SelectedItem="{Binding Library.SelectedCategory}"
                                          Background="{DynamicResource Med.PanelAlt}"
                                          Foreground="{DynamicResource Med.Text}"
                                          BorderBrush="{DynamicResource Med.Border}"
                                          Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Seções que ainda não são de mídia -->
                        <TextBlock Grid.Row="1" Text="{StaticResource Editor.Biblioteca.SecaoIndisponivel}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Med.MutedText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUnavailableSection}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Transições, efeitos e cor: aplicam ao clipe selecionado na linha do tempo (F6) -->
                        <DockPanel Grid.Row="1" Margin="0,8,0,0">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEffectSection}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Med.MutedText}" TextWrapping="Wrap" Margin="4,0,4,8"
                                       Text="Selecione um clipe na linha do tempo e clique duas vezes num item (ou use Aplicar)." />
                            <Button DockPanel.Dock="Bottom" Content="Aplicar ao clipe selecionado" Margin="4,8,4,0" HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Aplicar ao clipe selecionado"
                                    Command="{Binding ApplySectionItemCommand}" CommandParameter="{Binding SelectedItem, ElementName=ListaEfeitos}" />
                            <ListBox x:Name="ListaEfeitos" ItemsSource="{Binding SectionItems}" AutomationProperties.Name="Catálogo"
                                     Background="{DynamicResource Med.PanelAlt}" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="ListaEfeitos_MouseDoubleClick">
                                <ListBox.Resources>
                                    <ResourceDictionary Source="Panels/InspectorTemplates.xaml" />
                                </ListBox.Resources>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </DockPanel>

                        <!-- Área da biblioteca: lista, arrastar e soltar (RF027) -->
                        <Border x:Name="BibliotecaArea" Grid.Row="1" Margin="0,8,0,0"
                                Background="{DynamicResource Med.PanelAlt}" CornerRadius="6"
                                AllowDrop="True"
                                DragEnter="BibliotecaArea_DragOver"
                                DragOver="BibliotecaArea_DragOver"
                                DragLeave="BibliotecaArea_DragLeave"
                                Drop="BibliotecaArea_Drop">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMediaSection}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <ListBox ItemsSource="{Binding Library.ItemsView}"
                                         PreviewMouseRightButtonDown="Biblioteca_PreviewMouseRightButtonDown"
                                         PreviewMouseLeftButtonDown="Biblioteca_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="Biblioteca_PreviewMouseMove"
                                         MouseDoubleClick="Biblioteca_MouseDoubleClick"
                                         SelectedItem="{Binding Library.SelectedItem}"
                                         AutomationProperties.Name="{StaticResource Editor.Biblioteca.Midias}"
                                         Background="Transparent" BorderThickness="0"
                                         Margin="4"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True">
                                    <ListBox.InputBindings>
                                        <KeyBinding Key="Delete" Command="{Binding Library.RemoveSelectedCommand}" />
                                        <KeyBinding Key="F2" Command="{Binding Library.RenameSelectedCommand}" />
                                    </ListBox.InputBindings>
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{StaticResource Editor.Ferramenta.AdicionarMidia}"
                                                      Command="{Binding PlacementTarget.DataContext.Timeline.AddSelectedMediaCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="{StaticResource Editor.Biblioteca.Renomear}"
                                                      Command="{Binding PlacementTarget.DataContext.Library.RenameSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{StaticResource Editor.Biblioteca.DefinirCategoria}"
                                                      Command="{Binding PlacementTarget.DataContext.Library.SetCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{StaticResource Editor.Biblioteca.RemoverCategoria}"
                                                      Command="{Binding PlacementTarget.DataContext.Library.ClearCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="{StaticResource Editor.Biblioteca.GerarProxy}"
                                                      Command="{Binding PlacementTarget.DataContext.Library.GenerateProxyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{StaticResource Editor.Biblioteca.ExcluirProxy}"
                                                      Command="{Binding PlacementTarget.DataContext.Library.DeleteProxyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="{StaticResource Editor.Biblioteca.RemoverDoProjeto}"
                                                      Command="{Binding PlacementTarget.DataContext.Library.RemoveSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Padding" Value="4" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type media:MediaItemViewModel}">
                                            <Grid ToolTip="{Binding ToolTip}" Background="Transparent">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Opacity" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                <Setter Property="Opacity" Value="0.6" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="72" Height="42" CornerRadius="4"
                                                        Background="{DynamicResource Med.MonitorBackground}" ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                        <Path Data="{Binding Waveform}" Stretch="Fill"
                                                              Fill="{DynamicResource Med.ClipAudio}" Margin="2,4">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Waveform}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                        <TextBlock Text="{Binding KindGlyph}" FontSize="16"
                                                                   HorizontalAlignment="Center" Foreground="{DynamicResource Med.TextMuted}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Med.Icon}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Thumbnail}" Value="{x:Null}" />
                                                                                <Condition Binding="{Binding Waveform}" Value="{x:Null}" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3"
                                                                Background="#99000000" Padding="3,0">
                                                            <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="White" />
                                                        </Border>
                                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3"
                                                                Background="#CC1E6FD9" Padding="3,0" CornerRadius="2"
                                                                Visibility="{Binding HasProxyLabel, Converter={StaticResource Editor.BoolToVis}}"
                                                                ToolTip="Proxy de edição 540p (usado só na pré-visualização)">
                                                            <TextBlock Text="{Binding ProxyLabel}" FontSize="10" Foreground="White"
                                                                       AutomationProperties.Name="{Binding ProxyLabel}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <Grid Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Med.Text}" />
                                                    <TextBlock Grid.Row="1" Text="{Binding Details}" Style="{StaticResource Med.MutedText}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="2" Text="{StaticResource Editor.Biblioteca.ArquivoNaoEncontrado}"
                                                               Foreground="{DynamicResource Med.Danger}" FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Estado vazio -->
                                <TextBlock Text="{Binding Library.EmptyMessage}"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Med.MutedText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Library.VisibleCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Progresso da importação -->
                                <Border VerticalAlignment="Bottom" Background="{DynamicResource Med.Panel}" Padding="8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Library.IsImporting}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Library.ImportStatus}" FontSize="11"
                                                   Foreground="{DynamicResource Med.Text}" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Height="4" Maximum="100" Margin="0,4,0,0"
                                                     Value="{Binding Library.ImportPercent}"
                                                     AutomationProperties.Name="{StaticResource Editor.Biblioteca.ProgressoImportacao}" />
                                    </StackPanel>
                                </Border>

                                <!-- Dica ao arrastar arquivos sobre a área -->
                                <Border x:Name="DicaSoltar" Visibility="Collapsed" IsHitTestVisible="False"
                                        Margin="2" BorderBrush="{DynamicResource Med.Accent}" BorderThickness="2"
                                        CornerRadius="6" Background="#333B82F6">
                                    <TextBlock Text="{StaticResource Editor.Biblioteca.SoltarParaImportar}"
                                               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Med.Text}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Background="{DynamicResource Med.Background}" />

            <!-- Painel B: Monitor -->
            <Border Grid.Column="2" Style="{StaticResource Med.PanelBorder}" Margin="4">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="Monitor" Grid.Row="0" Background="{DynamicResource Med.MonitorBackground}" CornerRadius="4" ClipToBounds="True"
                            MouseLeftButtonDown="Monitor_MouseLeftButtonDown">
                        <Grid>
                            <Image Source="{Binding Preview.Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear"
                                   AutomationProperties.Name="{StaticResource Editor.Monitor.Imagem}" />
                            <TextBlock Text="{StaticResource Editor.Monitor.PreVisualizacao}" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Med.MutedText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Preview.HasContent}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Preview.Status}" FontSize="10" Margin="6,4" Opacity="0.7"
                                       Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button AutomationProperties.Name="{StaticResource Editor.Monitor.IrInicio}" Style="{StaticResource Editor.Controle}" Command="{Binding Timeline.GoToStartCommand}" ToolTip="{StaticResource Editor.Monitor.IrInicio}">
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE892;" />
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Monitor.Retroceder}" Style="{StaticResource Editor.Controle}" Command="{Binding Timeline.StepBackCommand}" ToolTip="{StaticResource Editor.Monitor.Retroceder}">
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xEB9E;" />
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Monitor.ReproduzirPausar}" Style="{StaticResource Editor.Controle}" Command="{Binding Preview.PlayPauseCommand}" ToolTip="{Binding Preview.PlayToolTip}">
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="{Binding Preview.PlayGlyph, FallbackValue=&#xE768;}" />
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Monitor.Avancar}" Style="{StaticResource Editor.Controle}" Command="{Binding Timeline.StepForwardCommand}" ToolTip="{StaticResource Editor.Monitor.Avancar}">
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xEB9D;" />
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Monitor.IrFim}" Style="{StaticResource Editor.Controle}" Command="{Binding Timeline.GoToEndCommand}" ToolTip="{StaticResource Editor.Monitor.IrFim}">
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE893;" />
                            </Button>

                            <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE767;" FontSize="14" Margin="10,0,6,0"
                                       ToolTip="{StaticResource Editor.Monitor.Volume}" />
                            <Slider Width="90" Minimum="0" Maximum="100" Value="{Binding Preview.Volume}"
                                    AutomationProperties.Name="{StaticResource Editor.Monitor.Volume}"
                                    VerticalAlignment="Center" ToolTip="{StaticResource Editor.Monitor.Volume}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding Timeline.TimeDisplay}"
                                   FontFamily="Consolas" FontSize="13"
                                   Foreground="{DynamicResource Med.Text}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding Preview.Qualities}" SelectedItem="{Binding Preview.Quality}"
                                      DisplayMemberPath="Label" MinWidth="88" Margin="0,0,4,0"
                                      AutomationProperties.Name="{StaticResource Editor.Monitor.Qualidade}"
                                      ToolTip="{StaticResource Editor.Monitor.Qualidade}" />
                            <ToggleButton Style="{StaticResource Editor.Alternar}" IsChecked="{Binding Preview.UseProxies}" Margin="0,0,4,0"
                                          AutomationProperties.Name="{StaticResource Editor.Monitor.UsarProxies}"
                                          ToolTip="{StaticResource Editor.Monitor.UsarProxies}">
                                <TextBlock Text="Proxy" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </ToggleButton>
                            <Button AutomationProperties.Name="{StaticResource Editor.Monitor.CapturarQuadro}" Style="{StaticResource Editor.Controle}"
                                    Command="{Binding Preview.CaptureFrameCommand}" ToolTip="{StaticResource Editor.Monitor.CapturarQuadro}">
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE722;" />
                            </Button>
                            <Button AutomationProperties.Name="{StaticResource Editor.Monitor.TelaCheia}" Style="{StaticResource Editor.Controle}"
                                    IsEnabled="{Binding Preview.HasContent, FallbackValue=False}" Click="TelaCheia_Click"
                                    ToolTip="{StaticResource Editor.Monitor.TelaCheia}">
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE740;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Background="{DynamicResource Med.Background}" />

            <!-- Painel C: Propriedades -->
            <Border Grid.Column="4" Style="{StaticResource Med.PanelBorder}" Margin="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{StaticResource Editor.Propriedades.Titulo}"
                               Style="{StaticResource Med.SectionTitle}" Margin="12,10,12,8" />

                    <TabControl Grid.Row="1" Margin="8,0,8,8"
                                Background="{DynamicResource Med.Panel}"
                                BorderBrush="{DynamicResource Med.Border}">
                        <TabItem Header="{StaticResource Editor.Propriedades.Midia}" IsSelected="True">
                            <Grid>
                                <TextBlock Text="{StaticResource Editor.Propriedades.SelecioneMidia}"
                                           TextWrapping="Wrap" Margin="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Med.MutedText}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Library.HasSelection}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                                    <ScrollViewer.Style>
                                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Library.HasSelection}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ScrollViewer.Style>
                                    <ItemsControl ItemsSource="{Binding Library.SelectedItem.InfoLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Med.MutedText}" FontSize="11" />
                                                    <TextBlock Text="{Binding Value}" Foreground="{DynamicResource Med.Text}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                        <TabItem Header="{StaticResource Editor.Propriedades.Video}" AutomationProperties.Name="{StaticResource Editor.Propriedades.Video}">
                            <panels:ClipVideoPanel DataContext="{Binding Inspector}" />
                        </TabItem>
                        <TabItem Header="{StaticResource Editor.Propriedades.Audio}" AutomationProperties.Name="{StaticResource Editor.Propriedades.Audio}">
                            <panels:ClipAudioPanel DataContext="{Binding AudioInspector}" />
                        </TabItem>
                        <TabItem Header="{StaticResource Editor.Propriedades.Efeitos}" AutomationProperties.Name="{StaticResource Editor.Propriedades.Efeitos}">
                            <panels:ClipEffectsPanel Mode="Effects" DataContext="{Binding Inspector}" />
                        </TabItem>
                        <TabItem Header="{StaticResource Editor.Propriedades.Cor}" AutomationProperties.Name="{StaticResource Editor.Propriedades.Cor}">
                            <panels:ClipEffectsPanel Mode="Color" DataContext="{Binding Inspector}" />
                        </TabItem>
                        <TabItem Header="{StaticResource Editor.Propriedades.Historico}" AutomationProperties.Name="{StaticResource Editor.Propriedades.Historico}">
                            <ListBox ItemsSource="{Binding HistoryItems}" Background="Transparent" BorderThickness="0"
                                     AutomationProperties.Name="{StaticResource Editor.Propriedades.Historico}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Med.ToolbarButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Padding="8,4" AutomationProperties.Name="{Binding Description}"
                                                Command="{Binding DataContext.GoToHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Med.Text}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUndone}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Med.TextMuted}" />
                                                                    <Setter Property="FontStyle" Value="Italic" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Med.Accent}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding Time}" Style="{StaticResource Med.MutedText}" Margin="8,0,0,0" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Divisor horizontal entre a área central e a parte inferior -->
        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource Med.Background}" />

        <!-- 5 e 6. Ferramentas (E) e Linha do tempo (D) -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="160" />
            </Grid.RowDefinitions>

            <!-- Painel E: Ferramentas da linha do tempo -->
            <Border Grid.Row="0" Style="{StaticResource Med.PanelBorder}" Height="40" Margin="4,4,4,0">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.AdicionarMidia}" Style="{StaticResource Editor.Controle}"
                                Command="{Binding Timeline.AddSelectedMediaCommand}" ToolTip="{StaticResource Editor.Ferramenta.AdicionarMidia}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE710;" />
                        </Button>
                        <Button x:Name="BotaoAdicionarTrilha" AutomationProperties.Name="{StaticResource Editor.Ferramenta.AdicionarTrilha}" Style="{StaticResource Editor.Controle}"
                                IsEnabled="{Binding Timeline.HasSession}" Click="AdicionarTrilha_Click" ToolTip="{StaticResource Editor.Ferramenta.AdicionarTrilha}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE8A5;" />
                                <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE70D;" FontSize="9" Margin="3,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{StaticResource Editor.Timeline.TrilhaVideo}" Command="{Binding Timeline.AddTrackCommand}" CommandParameter="{x:Static model:TrackKind.Video}" />
                                    <MenuItem Header="{StaticResource Editor.Timeline.TrilhaAudio}" Command="{Binding Timeline.AddTrackCommand}" CommandParameter="{x:Static model:TrackKind.Audio}" />
                                    <MenuItem Header="{StaticResource Editor.Timeline.TrilhaImagem}" Command="{Binding Timeline.AddTrackCommand}" CommandParameter="{x:Static model:TrackKind.Image}" />
                                    <MenuItem Header="{StaticResource Editor.Timeline.TrilhaTexto}" Command="{Binding Timeline.AddTrackCommand}" CommandParameter="{x:Static model:TrackKind.Text}" />
                                    <MenuItem Header="{StaticResource Editor.Timeline.TrilhaLegenda}" Command="{Binding Timeline.AddTrackCommand}" CommandParameter="{x:Static model:TrackKind.Subtitle}" />
                                    <MenuItem Header="{StaticResource Editor.Timeline.TrilhaEfeitos}" Command="{Binding Timeline.AddTrackCommand}" CommandParameter="{x:Static model:TrackKind.Effect}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Rectangle Width="1" Height="20" Margin="6,0" Fill="{DynamicResource Med.Border}" />
                        <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.Dividir}" Style="{StaticResource Editor.Controle}"
                                Command="{Binding Timeline.SplitCommand}" ToolTip="{StaticResource Editor.Ferramenta.Dividir}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE8C6;" />
                        </Button>
                        <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.Excluir}" Style="{StaticResource Editor.Controle}"
                                Command="{Binding Timeline.DeleteCommand}" ToolTip="{StaticResource Editor.Ferramenta.Excluir}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE74D;" />
                        </Button>
                        <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.ExcluirRipple}" Style="{StaticResource Editor.Controle}"
                                Command="{Binding Timeline.RippleDeleteCommand}" ToolTip="{StaticResource Editor.Ferramenta.ExcluirRipple}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE8BB;" />
                        </Button>
                        <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.Marcador}" Style="{StaticResource Editor.Controle}"
                                Command="{Binding Timeline.AddMarkerCommand}" ToolTip="{StaticResource Editor.Ferramenta.Marcador}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE7C1;" />
                        </Button>
                        <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.Mixer}" Style="{StaticResource Editor.Controle}"
                                Click="Mixer_Click" ToolTip="{StaticResource Editor.Ferramenta.Mixer}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE9E9;" />
                        </Button>
                        <Rectangle Width="1" Height="20" Margin="6,0" Fill="{DynamicResource Med.Border}" />
                        <ToggleButton AutomationProperties.Name="{StaticResource Editor.Ferramenta.Ima}" Style="{StaticResource Editor.Alternar}"
                                      IsChecked="{Binding Timeline.SnapEnabled}" ToolTip="{StaticResource Editor.Ferramenta.Ima}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE71B;" />
                        </ToggleButton>
                        <ToggleButton AutomationProperties.Name="{StaticResource Editor.Ferramenta.Ripple}" Style="{StaticResource Editor.Alternar}"
                                      IsChecked="{Binding Timeline.RippleEnabled}" ToolTip="{StaticResource Editor.Ferramenta.Ripple}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE8AB;" />
                        </ToggleButton>
                        <TextBlock Text="{Binding Timeline.SelectionSummary}" Style="{StaticResource Med.MutedText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.AfastarZoom}" Style="{StaticResource Editor.Controle}"
                                Command="{Binding Timeline.ZoomOutCommand}" ToolTip="{StaticResource Editor.Ferramenta.AfastarZoom}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE71F;" />
                        </Button>
                        <Slider Width="140" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                AutomationProperties.Name="{StaticResource Editor.Ferramenta.Zoom}"
                                Value="{Binding Timeline.ZoomSlider}" ToolTip="{Binding Timeline.ZoomLabel}" />
                        <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.AproximarZoom}" Style="{StaticResource Editor.Controle}"
                                Command="{Binding Timeline.ZoomInCommand}" ToolTip="{StaticResource Editor.Ferramenta.AproximarZoom}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE71E;" />
                        </Button>
                        <Button AutomationProperties.Name="{StaticResource Editor.Ferramenta.AjustarZoom}" Style="{StaticResource Editor.Controle}"
                                Command="{Binding Timeline.ZoomToFitCommand}" ToolTip="{StaticResource Editor.Ferramenta.AjustarZoom}">
                            <TextBlock Style="{StaticResource Editor.Icone}" Text="&#xE9A6;" />
                        </Button>
                        <TextBlock Text="{Binding Timeline.ZoomLabel}" Style="{StaticResource Med.MutedText}" Width="64" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Painel D: Linha do tempo -->
            <Border Grid.Row="1" Style="{StaticResource Med.PanelBorder}" Margin="4" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="176" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource Med.Panel}"
                            BorderBrush="{DynamicResource Med.Border}" BorderThickness="0,0,1,1">
                        <TextBlock Text="{Binding Timeline.TimeDisplay}" FontFamily="Consolas" FontSize="11"
                                   Foreground="{DynamicResource Med.TextMuted}" VerticalAlignment="Center" Margin="8,0" />
                    </Border>

                    <ctl:TimelineRuler x:Name="Regua" Grid.Row="0" Grid.Column="1" ViewModel="{Binding Timeline}"
                                       AutomationProperties.Name="{StaticResource Editor.Timeline.Regua}">
                        <ctl:TimelineRuler.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{StaticResource Editor.Timeline.RenomearMarcador}" Click="RenomearMarcador_Click" />
                                <MenuItem Header="{StaticResource Editor.Timeline.RemoverMarcador}" Click="RemoverMarcador_Click" />
                            </ContextMenu>
                        </ctl:TimelineRuler.ContextMenu>
                    </ctl:TimelineRuler>

                    <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="176" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ItemsControl Grid.Column="0" ItemsSource="{Binding Timeline.Tracks}" Focusable="False"
                                          AutomationProperties.Name="{StaticResource Editor.Timeline.Trilhas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type tl:TrackHeaderViewModel}">
                                        <Border Height="{Binding Height}" Background="{DynamicResource Med.Panel}"
                                                BorderBrush="{DynamicResource Med.Border}" BorderThickness="0,0,1,1"
                                                AutomationProperties.Name="{Binding Name}">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{StaticResource Editor.Timeline.RenomearTrilha}" Command="{Binding RenameCommand}" />
                                                    <MenuItem Header="{StaticResource Editor.Timeline.RemoverTrilha}" Command="{Binding RemoveCommand}" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid Margin="6,0,2,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Med.Icon}" Text="{Binding KindGlyph}" FontSize="12"
                                                           Foreground="{DynamicResource Med.TextMuted}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Margin="6,0,2,0"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="2" Style="{StaticResource Editor.TrilhaBotao}" Command="{Binding ToggleHiddenCommand}"
                                                        AutomationProperties.Name="{Binding HideToolTip}" ToolTip="{Binding HideToolTip}"
                                                        Visibility="{Binding CanHide, Converter={StaticResource Editor.BoolVisivel}}">
                                                    <TextBlock Style="{StaticResource Med.Icon}" Text="{Binding HideGlyph}" FontSize="12" />
                                                </Button>
                                                <Button Grid.Column="3" Style="{StaticResource Editor.TrilhaBotao}" Command="{Binding ToggleMutedCommand}"
                                                        AutomationProperties.Name="{Binding MuteToolTip}" ToolTip="{Binding MuteToolTip}"
                                                        Visibility="{Binding CanMute, Converter={StaticResource Editor.BoolVisivel}}">
                                                    <TextBlock Style="{StaticResource Med.Icon}" Text="{Binding MuteGlyph}" FontSize="12" />
                                                </Button>
                                                <Button Grid.Column="4" Style="{StaticResource Editor.TrilhaBotao}" Command="{Binding ToggleLockCommand}"
                                                        AutomationProperties.Name="{Binding LockToolTip}" ToolTip="{Binding LockToolTip}">
                                                    <TextBlock Style="{StaticResource Med.Icon}" Text="{Binding LockGlyph}" FontSize="12" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ctl:TimelineControl x:Name="LinhaDoTempo" Grid.Column="1" ViewModel="{Binding Timeline}"
                                                 Height="{Binding Timeline.TracksHeight}" VerticalAlignment="Top"
                                                 AutomationProperties.Name="{StaticResource Editor.Timeline.Nome}">
                                <ctl:TimelineControl.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{StaticResource Editor.Timeline.Dividir}" InputGestureText="S" Command="{Binding Timeline.SplitCommand}" />
                                        <Separator />
                                        <MenuItem Header="{StaticResource Editor.Timeline.Recortar}" InputGestureText="Ctrl+X" Command="{Binding Timeline.CutCommand}" />
                                        <MenuItem Header="{StaticResource Editor.Timeline.Copiar}" InputGestureText="Ctrl+C" Command="{Binding Timeline.CopyCommand}" />
                                        <MenuItem Header="{StaticResource Editor.Timeline.Colar}" InputGestureText="Ctrl+V" Command="{Binding Timeline.PasteCommand}" />
                                        <MenuItem Header="{StaticResource Editor.Timeline.Duplicar}" InputGestureText="Ctrl+D" Command="{Binding Timeline.DuplicateCommand}" />
                                        <Separator />
                                        <MenuItem Header="{StaticResource Editor.Timeline.Velocidade}" Command="{Binding Timeline.SetSpeedCommand}" />
                                        <MenuItem Header="{StaticResource Editor.Timeline.Agrupar}" InputGestureText="Ctrl+G" Command="{Binding Timeline.GroupCommand}" />
                                        <MenuItem Header="{StaticResource Editor.Timeline.Desagrupar}" InputGestureText="Ctrl+Shift+G" Command="{Binding Timeline.UngroupCommand}" />
                                        <MenuItem Header="{StaticResource Editor.Timeline.Vincular}" Command="{Binding Timeline.LinkCommand}" />
                                        <MenuItem Header="{StaticResource Editor.Timeline.Desvincular}" Command="{Binding Timeline.UnlinkCommand}" />
                                        <Separator />
                                        <MenuItem Header="{StaticResource Editor.Timeline.SelecionarTudo}" InputGestureText="Ctrl+A" Command="{Binding Timeline.SelectAllCommand}" />
                                        <MenuItem Header="{StaticResource Editor.Timeline.Excluir}" InputGestureText="Delete" Command="{Binding Timeline.DeleteCommand}" />
                                        <MenuItem Header="{StaticResource Editor.Timeline.ExcluirRipple}" InputGestureText="Shift+Delete" Command="{Binding Timeline.RippleDeleteCommand}" />
                                    </ContextMenu>
                                </ctl:TimelineControl.ContextMenu>
                            </ctl:TimelineControl>
                        </Grid>
                    </ScrollViewer>

                    <ScrollBar Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Minimum="0"
                               AutomationProperties.Name="{StaticResource Editor.Timeline.Rolagem}"
                               Maximum="{Binding Timeline.MaxHorizontalOffset, Mode=OneWay}"
                               ViewportSize="{Binding Timeline.ViewportWidth, Mode=OneWay}"
                               LargeChange="{Binding Timeline.ViewportWidth, Mode=OneWay}" SmallChange="40"
                               Value="{Binding Timeline.HorizontalOffset}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
