<UserControl x:Class="MeuEditorDeVideo.App.Views.Panels.ClipTextPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ins="clr-namespace:MeuEditorDeVideo.App.ViewModels.Inspector">
    <!-- Aba "Texto" do painel C (F8): conteúdo, fonte, cores, contorno, sombra, caixa, posição e animações. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="InspectorTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type ins:TextColorViewModel}">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Ins.Label}" TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="3" BorderBrush="{DynamicResource Med.Border}" BorderThickness="1">
                                <Border.Background>
                                    <!-- Xadrez sob a amostra para mostrar transparência -->
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="#FF9A9A9A" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z" />
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.Background>
                                <Border Background="{Binding Swatch}" CornerRadius="2" />
                            </Border>
                            <TextBox Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" Width="96" Margin="6,0,0,0" MaxLength="9"
                                     AutomationProperties.Name="{Binding Label}"
                                     ToolTip="Cor em hexadecimal: #RRGGBB ou #AARRGGBB (AA = opacidade, 00 transparente a FF opaca)" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Presets}" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="18" Height="18" Margin="0,0,4,4" Padding="0" BorderThickness="1" BorderBrush="{DynamicResource Med.Border}"
                                            Background="{Binding}" ToolTip="{Binding}" AutomationProperties.Name="{Binding}"
                                            Command="{Binding DataContext.UsePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <Style x:Key="Txt.Row" TargetType="Grid">
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <TextBlock Text="Selecione um texto, título, crédito, tarja ou legenda na linha do tempo. Para criar um, use a seção Textos da biblioteca."
                   TextWrapping="Wrap" Margin="12">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Med.MutedText}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasClip}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,4,10,10"
                      Visibility="{Binding HasClip, Converter={StaticResource Ins.BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" Foreground="{DynamicResource Med.Text}" Margin="0,6,0,0" />

                <TextBlock Text="Conteúdo" Style="{StaticResource Ins.Section}" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="64" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Conteúdo do texto" ToolTip="Enter quebra a linha" />
                <TextBlock Style="{StaticResource Ins.Label}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Visibility="{Binding IsCredits, Converter={StaticResource Ins.BoolToVis}}"
                           Text="Os créditos rolam de baixo para cima durante todo o clipe: alongue o clipe para rolar mais devagar." />

                <TextBlock Text="Fonte" Style="{StaticResource Ins.Section}" />
                <Grid Style="{StaticResource Txt.Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Fonts}" SelectedItem="{Binding FontFamily}" IsTextSearchEnabled="True"
                              AutomationProperties.Name="Fonte" ToolTip="Fonte do texto (do sistema ou adicionadas ao aplicativo)">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="14" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Content="+ Fonte" Margin="6,0,0,0" Padding="8,2" Command="{Binding AddFontCommand}"
                            AutomationProperties.Name="Adicionar fonte" ToolTip="Adicionar um arquivo de fonte (.ttf, .otf) ao aplicativo" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <ToggleButton IsChecked="{Binding Bold}" Width="32" Margin="0,0,4,0" FontWeight="Bold" Content="N"
                                  AutomationProperties.Name="Negrito" ToolTip="Negrito" />
                    <ToggleButton IsChecked="{Binding Italic}" Width="32" Margin="0,0,4,0" FontStyle="Italic" Content="I"
                                  AutomationProperties.Name="Itálico" ToolTip="Itálico" />
                    <ToggleButton IsChecked="{Binding Underline}" Width="32" Margin="0,0,12,0" AutomationProperties.Name="Sublinhado" ToolTip="Sublinhado">
                        <TextBlock Text="S" TextDecorations="Underline" />
                    </ToggleButton>
                    <ComboBox ItemsSource="{Binding Alignments}" SelectedItem="{Binding Alignment}" DisplayMemberPath="Label" MinWidth="96"
                              AutomationProperties.Name="Alinhamento" ToolTip="Alinhamento das linhas; à esquerda, a posição X é a borda esquerda do bloco" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Values}" />
                <ContentControl Content="{Binding TextColor}" Focusable="False" />

                <TextBlock Text="Contorno" Style="{StaticResource Ins.Section}" />
                <ItemsControl ItemsSource="{Binding Outline}" />
                <ContentControl Content="{Binding OutlineColor}" Focusable="False" />

                <TextBlock Text="Sombra" Style="{StaticResource Ins.Section}" />
                <CheckBox IsChecked="{Binding Shadow}" Content="Sombra projetada" Margin="0,0,0,6" AutomationProperties.Name="Sombra projetada" />
                <StackPanel Visibility="{Binding Shadow, Converter={StaticResource Ins.BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding ShadowValues}" />
                    <ContentControl Content="{Binding ShadowColor}" Focusable="False" />
                </StackPanel>

                <TextBlock Text="Caixa de fundo" Style="{StaticResource Ins.Section}" />
                <ContentControl Content="{Binding BackgroundColor}" Focusable="False" />
                <ContentControl Content="{Binding AccentColor}" Focusable="False" />
                <ItemsControl ItemsSource="{Binding BoxValues}" />

                <TextBlock Text="Posição" Style="{StaticResource Ins.Section}" />
                <Grid Style="{StaticResource Txt.Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ponto de apoio" Style="{StaticResource Ins.Label}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Anchors}" SelectedItem="{Binding Anchor}" DisplayMemberPath="Label"
                              AutomationProperties.Name="Ponto de apoio vertical"
                              ToolTip="Qual parte do bloco fica na posição Y (aba Vídeo). Na base, linhas novas crescem para cima." />
                </Grid>
                <TextBlock Style="{StaticResource Ins.Label}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Posição, escala, rotação, opacidade e keyframes ficam na aba Vídeo." />

                <TextBlock Text="Animação" Style="{StaticResource Ins.Section}" />
                <Grid Style="{StaticResource Txt.Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Entrada" Style="{StaticResource Ins.Label}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Animations}" SelectedItem="{Binding AnimationIn}" DisplayMemberPath="Label"
                              AutomationProperties.Name="Animação de entrada" />
                    <TextBlock Grid.Row="1" Text="Saída" Style="{StaticResource Ins.Label}" Margin="0,6,0,0" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Animations}" SelectedItem="{Binding AnimationOut}" DisplayMemberPath="Label"
                              AutomationProperties.Name="Animação de saída" Margin="0,6,0,0" />
                </Grid>
                <ItemsControl ItemsSource="{Binding AnimationValues}" />

                <StackPanel Visibility="{Binding IsSubtitle, Converter={StaticResource Ins.BoolToVis}}" Margin="0,8,0,0">
                    <Button Content="Aplicar este estilo a todas as legendas da trilha" Command="{Binding ApplyStyleToTrackCommand}"
                            AutomationProperties.Name="Aplicar este estilo a todas as legendas da trilha" HorizontalAlignment="Stretch" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
