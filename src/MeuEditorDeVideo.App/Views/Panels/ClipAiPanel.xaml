<UserControl x:Class="MeuEditorDeVideo.App.Views.Panels.ClipAiPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aba "IA" do painel C (F10): recursos de IA local. Sem modelo instalado, cada recurso aparece como indisponível. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="InspectorTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Ai.Status" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Foreground" Value="{DynamicResource Med.TextMuted}" />
            </Style>
            <Style x:Key="Ai.Button" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="0,2,0,4" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <TextBlock Text="Selecione um clipe na linha do tempo para usar os recursos de inteligência artificial (processados neste computador)."
                   TextWrapping="Wrap" Margin="12">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Med.MutedText}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasClip}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,4,10,10"
                      Visibility="{Binding HasClip, Converter={StaticResource Ins.BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding ClipTitle}" FontWeight="SemiBold" Foreground="{DynamicResource Med.Text}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />

                <!-- Processamento em andamento -->
                <Border Visibility="{Binding IsBusy, Converter={StaticResource Ins.BoolToVis}}" Background="{DynamicResource Med.PanelAlt}"
                        CornerRadius="4" Padding="8" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding BusyText}" Foreground="{DynamicResource Med.Text}" />
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="Cancelar" Style="{StaticResource Ins.SmallButton}" Margin="6,0,0,0"
                                    Command="{Binding CancelCommand}" AutomationProperties.Name="Cancelar processamento de IA" />
                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="8" VerticalAlignment="Center"
                                         AutomationProperties.Name="Progresso da IA" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource Med.Text}" Margin="0,8,0,0"
                           />

                <!-- Fundo e pessoas -->
                <StackPanel Visibility="{Binding IsVisualMedia, Converter={StaticResource Ins.BoolToVis}}">
                    <TextBlock Text="Fundo e pessoas" Style="{StaticResource Ins.Section}" />
                    <TextBlock Text="{Binding SegmentationStatus}" Style="{StaticResource Ai.Status}" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Novo fundo" Style="{StaticResource Ins.Label}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding BackgroundModes}" SelectedItem="{Binding SelectedBackgroundMode}"
                                  DisplayMemberPath="Label" Margin="0,0,0,4" AutomationProperties.Name="Novo fundo" />
                        <TextBlock Grid.Row="1" Text="Mídia" Style="{StaticResource Ins.Label}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding BackgroundMedia}" SelectedItem="{Binding SelectedBackgroundMedia}"
                                  DisplayMemberPath="Label" Margin="0,0,0,4" AutomationProperties.Name="Mídia do fundo"
                                  ToolTip="Imagem ou vídeo da biblioteca usado como fundo" />
                    </Grid>
                    <Button Command="{Binding RemoveBackgroundCommand}" Style="{StaticResource Ai.Button}" AutomationProperties.Name="Remover fundo com IA">
                        <Button.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Remover fundo" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasBackgroundEffect}" Value="True">
                                                <Setter Property="Text" Value="Aplicar o novo fundo" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                    <Button Content="Calcular máscaras em segundo plano" Command="{Binding PrecomputeMattesCommand}" Style="{StaticResource Ai.Button}"
                            ToolTip="Processa todos os quadros e guarda as máscaras no cache: reprodução e exportação ficam mais rápidas." />
                    <Button Content="Rastrear pessoa" Command="{Binding TrackPersonCommand}" Style="{StaticResource Ai.Button}"
                            AutomationProperties.Name="Rastrear pessoa com IA"
                            ToolTip="Cria um rastreamento com a posição da pessoa em cada quadro (use na aba Composição para vincular elementos)." />
                </StackPanel>

                <!-- Cenas -->
                <StackPanel Visibility="{Binding IsVideo, Converter={StaticResource Ins.BoolToVis}}">
                    <TextBlock Text="Cenas" Style="{StaticResource Ins.Section}" />
                    <TextBlock Text="{Binding SceneStatus}" Style="{StaticResource Ai.Status}" />
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Sensibilidade" Style="{StaticResource Ins.Label}" Width="92" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SceneSensitivityDisplay}" Width="40" TextAlignment="Right" Foreground="{DynamicResource Med.Text}" />
                        <Slider Minimum="0" Maximum="100" Value="{Binding SceneSensitivity}" AutomationProperties.Name="Sensibilidade das cenas" />
                    </DockPanel>
                    <CheckBox Content="Dividir o clipe em cada cena" IsChecked="{Binding SplitAtScenes}" Margin="0,2,0,4" />
                    <Button Content="Detectar cenas" Command="{Binding DetectScenesCommand}" Style="{StaticResource Ai.Button}"
                            AutomationProperties.Name="Detectar cenas"
                            ToolTip="Cria marcadores nas mudanças de cena (e divide o clipe, se marcado)." />
                </StackPanel>

                <!-- Melhoria de imagem -->
                <StackPanel Visibility="{Binding IsImage, Converter={StaticResource Ins.BoolToVis}}">
                    <TextBlock Text="Imagem" Style="{StaticResource Ins.Section}" />
                    <TextBlock Text="{Binding EnhancerStatus}" Style="{StaticResource Ai.Status}" />
                    <Button Content="Melhorar imagem (ampliar 2×)" Command="{Binding EnhanceImageCommand}" Style="{StaticResource Ai.Button}"
                            AutomationProperties.Name="Melhorar imagem com IA" />
                </StackPanel>

                <!-- Fala e áudio -->
                <StackPanel Visibility="{Binding HasAudio, Converter={StaticResource Ins.BoolToVis}}">
                    <TextBlock Text="Legendas automáticas" Style="{StaticResource Ins.Section}" />
                    <TextBlock Text="{Binding SpeechStatus}" Style="{StaticResource Ai.Status}" />
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Idioma" Style="{StaticResource Ins.Label}" Width="92" />
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="Idioma da fala" />
                    </DockPanel>
                    <Button Content="Gerar legendas" Command="{Binding GenerateSubtitlesCommand}" Style="{StaticResource Ai.Button}"
                            AutomationProperties.Name="Gerar legendas com IA" />

                    <TextBlock Text="Voz" Style="{StaticResource Ins.Section}" />
                    <TextBlock Text="{Binding VoiceStatus}" Style="{StaticResource Ai.Status}" />
                    <CheckBox Content="Silenciar o áudio original" IsChecked="{Binding MuteOriginal}" Margin="0,2,0,4" />
                    <Button Content="Isolar voz (voz e ambiente separados)" Command="{Binding IsolateVoiceCommand}" Style="{StaticResource Ai.Button}"
                            AutomationProperties.Name="Isolar voz com IA" />
                    <DockPanel Margin="0,4,0,4">
                        <TextBlock Text="Intensidade" Style="{StaticResource Ins.Label}" Width="92" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DenoiseStrengthDisplay}" Width="40" TextAlignment="Right" Foreground="{DynamicResource Med.Text}" />
                        <Slider Minimum="0" Maximum="100" Value="{Binding DenoiseStrength}" AutomationProperties.Name="Intensidade da redução de ruído" />
                    </DockPanel>
                    <Button Content="Reduzir ruído" Command="{Binding DenoiseCommand}" Style="{StaticResource Ai.Button}"
                            AutomationProperties.Name="Reduzir ruído com IA" />

                    <TextBlock Text="Silêncios" Style="{StaticResource Ins.Section}" />
                    <TextBlock Text="{Binding VadStatus}" Style="{StaticResource Ai.Status}" />
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Pausa mínima" Style="{StaticResource Ins.Label}" Width="92" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SilenceMinDisplay}" Width="40" TextAlignment="Right" Foreground="{DynamicResource Med.Text}" />
                        <Slider Minimum="0.2" Maximum="5" Value="{Binding SilenceMinSeconds}" AutomationProperties.Name="Pausa mínima sem fala" />
                    </DockPanel>
                    <Button Content="Remover trechos sem fala" Command="{Binding RemoveSilenceCommand}" Style="{StaticResource Ai.Button}"
                            AutomationProperties.Name="Remover trechos sem fala com IA" />
                </StackPanel>

                <TextBlock Text="Os modelos rodam somente neste computador; nada é enviado para a internet. Gerencie-os em Ferramentas › Modelos de IA."
                           Style="{StaticResource Ai.Status}" Margin="0,14,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
