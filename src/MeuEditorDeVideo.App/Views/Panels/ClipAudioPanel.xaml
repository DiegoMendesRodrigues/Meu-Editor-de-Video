<UserControl x:Class="MeuEditorDeVideo.App.Views.Panels.ClipAudioPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aba "Áudio" do painel C (F7): volume e keyframes, rampas, tom, efeitos, normalização, silêncios e sincronização. -->
    <UserControl.Resources>
        <ResourceDictionary Source="InspectorTemplates.xaml" />
    </UserControl.Resources>
    <Grid>
        <TextBlock Text="Selecione um clipe de áudio (ou um vídeo com áudio vinculado) na linha do tempo para ajustar volume, efeitos e loudness."
                   TextWrapping="Wrap" Margin="12">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Med.MutedText}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasClip}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,4,10,10"
                      Visibility="{Binding HasClip, Converter={StaticResource Ins.BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding ClipTitle}" FontWeight="SemiBold" Foreground="{DynamicResource Med.Text}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />

                <TextBlock Text="Volume" Style="{StaticResource Ins.Section}" />
                <ContentControl Content="{Binding Volume}" Focusable="False" />
                <TextBlock Style="{StaticResource Ins.Label}" TextWrapping="Wrap" Margin="0,2,0,6"
                           Text="100% = volume original. ◇ cria um keyframe de volume no instante do cursor (ex.: abaixar a música durante uma fala)." />
                <ItemsControl ItemsSource="{Binding Fades}" />

                <StackPanel Visibility="{Binding HasSpeedChange, Converter={StaticResource Ins.BoolToVis}}" Margin="0,6,0,0">
                    <CheckBox IsChecked="{Binding PreservePitch}" AutomationProperties.Name="Manter o tom"
                              ToolTip="Mantém a voz natural ao acelerar ou desacelerar o clipe">
                        <TextBlock>
                            <Run Text="Manter o tom na velocidade" />
                            <Run Text="{Binding SpeedText, Mode=OneWay}" />
                        </TextBlock>
                    </CheckBox>
                </StackPanel>

                <TextBlock Text="Normalizar loudness" Style="{StaticResource Ins.Section}" />
                <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Label"
                          AutomationProperties.Name="Alvo de loudness" Margin="0,0,0,6" />
                <Button Content="Normalizar" Style="{StaticResource Ins.SmallButton}" HorizontalAlignment="Left"
                        Command="{Binding NormalizeCommand}" AutomationProperties.Name="Normalizar"
                        ToolTip="Mede o loudness (EBU R128) e ajusta o volume para o alvo, sem passar de −1 dBFS de pico" />

                <TextBlock Text="Remover silêncios" Style="{StaticResource Ins.Section}" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Limiar" Style="{StaticResource Ins.Label}" />
                    <Slider Grid.Column="1" Minimum="-70" Maximum="-20" Value="{Binding SilenceThreshold}" SmallChange="1" LargeChange="5"
                            IsMoveToPointEnabled="True" AutomationProperties.Name="Limiar de silêncio"
                            ToolTip="Abaixo deste nível o som é considerado silêncio" />
                    <TextBlock Grid.Column="2" Text="{Binding SilenceThresholdDisplay}" Style="{StaticResource Ins.Label}" TextAlignment="Right" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Duração mínima" Style="{StaticResource Ins.Label}" />
                    <Slider Grid.Column="1" Minimum="0.2" Maximum="5" Value="{Binding SilenceMinSeconds}" SmallChange="0.1" LargeChange="0.5"
                            IsMoveToPointEnabled="True" AutomationProperties.Name="Duração mínima do silêncio" />
                    <TextBlock Grid.Column="2" Text="{Binding SilenceMinDisplay}" Style="{StaticResource Ins.Label}" TextAlignment="Right" />
                </Grid>
                <Button Content="Remover silêncios" Style="{StaticResource Ins.SmallButton}" HorizontalAlignment="Left"
                        Command="{Binding RemoveSilenceCommand}" AutomationProperties.Name="Remover silêncios"
                        ToolTip="Corta os silêncios do clipe (e do vídeo vinculado) e fecha os espaços" />

                <TextBlock Text="Sincronizar pelo áudio" Style="{StaticResource Ins.Section}" />
                <TextBlock Style="{StaticResource Ins.Label}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Selecione dois clipes de áudio do mesmo acontecimento (ex.: câmera e gravador). O da trilha mais acima fica parado; o outro é movido." />
                <Button Content="Sincronizar" Style="{StaticResource Ins.SmallButton}" HorizontalAlignment="Left"
                        Command="{Binding SyncCommand}" AutomationProperties.Name="Sincronizar pelo áudio" />

                <TextBlock Text="{Binding AnalysisStatus}" Style="{StaticResource Ins.Label}" TextWrapping="Wrap" Margin="0,8,0,0"
                           AutomationProperties.AutomationId="StatusAudio" />

                <TextBlock Text="Adicionar efeito de áudio" Style="{StaticResource Ins.Section}" />
                <ItemsControl ItemsSource="{Binding LibraryAudio}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}" Style="{StaticResource Ins.SmallButton}" ToolTip="{Binding Description}"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Adicionar {0}'}"
                                    Command="{Binding DataContext.AddEffectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Key}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Efeitos de áudio aplicados (em ordem)" Style="{StaticResource Ins.Section}" />
                <ItemsControl ItemsSource="{Binding Effects}" AutomationProperties.Name="Efeitos de áudio aplicados" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
