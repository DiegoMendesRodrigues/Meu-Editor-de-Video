<UserControl x:Class="MeuEditorDeVideo.App.Views.Panels.AssistantPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Assistente virtual">
    <!-- Ajuda › Assistente virtual: perguntas respondidas com base no manual, no idioma do programa, sem internet. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Assistente.Visivel" />
        <Style x:Key="Assistente.Fonte" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,4,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10,8,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <DockPanel Grid.Row="0" LastChildFill="True">
            <Button DockPanel.Dock="Right" Style="{StaticResource Med.ToolbarButton}" Click="Fechar_Click"
                    ToolTip="Fechar o assistente" AutomationProperties.Name="Fechar o assistente">
                <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE711;" />
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource Med.ToolbarButton}" Command="{Binding ClearCommand}"
                    ToolTip="Nova conversa" AutomationProperties.Name="Nova conversa">
                <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE710;" />
            </Button>
            <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE99A;" Foreground="{DynamicResource Med.Accent}" FontSize="18"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Assistente virtual" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Med.Text}" />
                <TextBlock Text="Responde com base no manual, sem internet." FontSize="11" Foreground="{DynamicResource Med.TextMuted}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- Aviso de instalação do modelo de linguagem -->
        <Border Grid.Row="1" Margin="0,10,0,0" Padding="10" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource Med.Accent}" Background="{DynamicResource Med.PanelAlt}"
                Visibility="{Binding ShowInstallCard, Converter={StaticResource Assistente.Visivel}}"
                AutomationProperties.Name="Instalar o modelo de linguagem">
            <StackPanel>
                <TextBlock Text="{Binding InstallText}" TextWrapping="Wrap" Foreground="{DynamicResource Med.Text}" FontSize="12" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Catalog.IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="Instalar" Style="{StaticResource Med.AccentButton}" Padding="14,4" Command="{Binding InstallModelCommand}"
                            AutomationProperties.Name="Instalar o modelo de linguagem" />
                    <Button Content="Agora não" Margin="8,0,0,0" Padding="12,4" Command="{Binding DismissInstallCardCommand}"
                            AutomationProperties.Name="Agora não" />
                </StackPanel>
                <StackPanel Margin="0,8,0,0" Visibility="{Binding Catalog.IsBusy, Converter={StaticResource Assistente.Visivel}}">
                    <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Catalog.Percent}" AutomationProperties.Name="Progresso da instalação" />
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Cancelar" Padding="10,2" Command="{Binding Catalog.CancelCommand}"
                                AutomationProperties.Name="Cancelar a instalação" />
                        <TextBlock Text="{Binding Catalog.Status}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Med.TextMuted}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                    </DockPanel>
                </StackPanel>
                <TextBlock Text="{Binding Catalog.Status}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Med.TextMuted}" Margin="0,6,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Catalog.IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Catalog.Status}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Conversa -->
        <ScrollViewer x:Name="Rolagem" Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="Conversa com o assistente">
            <StackPanel>
                <!-- Conversa vazia: sugestões -->
                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource Assistente.Visivel}}" Margin="0,4,0,0">
                    <TextBlock Text="Pergunte sobre qualquer recurso do programa ou sobre edição de vídeo. Por exemplo:"
                               TextWrapping="Wrap" Foreground="{DynamicResource Med.TextMuted}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Suggestions}" AutomationProperties.Name="Perguntas sugeridas">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,6" Padding="10,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Command="{Binding DataContext.AskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding}">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Messages}" AutomationProperties.Name="Mensagens">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Balao" Margin="0,0,24,10" Padding="10,8" CornerRadius="8" HorizontalAlignment="Left"
                                    Background="{DynamicResource Med.PanelAlt}" BorderBrush="{DynamicResource Med.Border}" BorderThickness="1">
                                <StackPanel>
                                    <!-- TextBox somente leitura: permite selecionar e copiar a resposta -->
                                    <TextBox x:Name="Texto" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0"
                                             Foreground="{DynamicResource Med.Text}" AutomationProperties.Name="Mensagem" />
                                    <!-- Sem modelo de linguagem: seções com um trecho -->
                                    <ItemsControl ItemsSource="{Binding Sources}"
                                                  Visibility="{Binding ShowExcerpts, Converter={StaticResource Assistente.Visivel}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,8,0,0" Padding="8" CornerRadius="6" Background="{DynamicResource Med.Panel}"
                                                        BorderBrush="{DynamicResource Med.Border}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Breadcrumb}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource Med.Text}" />
                                                        <TextBlock Text="{Binding Excerpt}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                                                                   Foreground="{DynamicResource Med.TextMuted}" />
                                                        <Button Content="Abrir no manual" Style="{StaticResource Assistente.Fonte}"
                                                                Command="{Binding DataContext.OpenSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" AutomationProperties.Name="Abrir no manual" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Com o modelo de linguagem: fonte da resposta -->
                                    <StackPanel x:Name="Fontes" Margin="0,8,0,0" Visibility="Collapsed">
                                        <TextBlock Text="Fonte no manual:" FontSize="11" Foreground="{DynamicResource Med.TextMuted}" />
                                        <ItemsControl ItemsSource="{Binding Sources}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Assistente.Fonte}" ToolTip="Abrir no manual"
                                                            Command="{Binding DataContext.OpenSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Breadcrumb}">
                                                        <TextBlock Text="{Binding Breadcrumb}" TextWrapping="Wrap" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding FromUser}" Value="True">
                                    <Setter TargetName="Balao" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Balao" Property="Margin" Value="24,0,0,10" />
                                    <Setter TargetName="Balao" Property="Background" Value="{DynamicResource Med.Accent}" />
                                    <Setter TargetName="Balao" Property="BorderThickness" Value="0" />
                                    <Setter TargetName="Texto" Property="Foreground" Value="{DynamicResource Med.OnAccent}" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasSources}" Value="True" />
                                        <Condition Binding="{Binding ShowExcerpts}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Fontes" Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Pergunta -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Pergunta" Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MaxHeight="120"
                     VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Pergunta ao assistente" PreviewKeyDown="Pergunta_PreviewKeyDown" />
            <Button x:Name="Enviar" Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource Med.AccentButton}" Padding="10,6" VerticalAlignment="Bottom"
                    Command="{Binding SendCommand}" ToolTip="Enviar (Enter)" AutomationProperties.Name="Enviar pergunta">
                <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE724;" Foreground="{DynamicResource Med.OnAccent}" />
            </Button>
            <Button x:Name="Parar" Grid.Column="1" Margin="6,0,0,0" Padding="10,6" VerticalAlignment="Bottom" Command="{Binding StopCommand}"
                    ToolTip="Parar a resposta" AutomationProperties.Name="Parar a resposta"
                    Visibility="{Binding IsBusy, Converter={StaticResource Assistente.Visivel}}">
                <TextBlock Style="{StaticResource Med.Icon}" Text="&#xE71A;" />
            </Button>
        </Grid>
        <TextBlock Grid.Row="4" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Med.TextMuted}"
                   Text="As respostas podem conter erros: confira no manual pela fonte indicada." />
    </Grid>
</UserControl>
