<Window x:Class="MeuEditorDeVideo.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MeuEditorDeVideo.Presentation.ViewModels;assembly=MeuEditorDeVideo.Presentation"
        x:Name="Root"
        Title="{Binding Title}"
        Icon="/Assets/logo-64.png"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource Med.Background}">
    <!-- Barra de título própria: as páginas desenham a faixa superior (40 px)
         e esta janela sobrepõe os botões de legenda à direita. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Janela.Legenda" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Med.Text}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource Med.PanelHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Raiz">
        <ContentControl Content="{Binding CurrentPage}" Focusable="False" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource Janela.Legenda}" Content="&#xE921;" Click="Minimizar_Click"
                    AutomationProperties.Name="Minimizar" ToolTip="Minimizar" />
            <Button x:Name="BotaoMaximizar" Style="{StaticResource Janela.Legenda}" Content="&#xE922;" Click="Maximizar_Click"
                    AutomationProperties.Name="Maximizar" ToolTip="Maximizar" />
            <Button Content="&#xE8BB;" Click="Fechar_Click" AutomationProperties.Name="Fechar" ToolTip="Fechar">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Janela.Legenda}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
