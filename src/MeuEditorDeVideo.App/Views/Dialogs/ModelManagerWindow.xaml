<Window x:Class="MeuEditorDeVideo.App.Views.Dialogs.ModelManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modelos de IA"
        Width="980"
        Height="760"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AutomationProperties.Name="Modelos de IA"
        Background="{DynamicResource Med.Background}"
        Foreground="{DynamicResource Med.Text}">
    <!-- Gerenciador de modelos (RF166–RF170, §8.3): instalação por pacotes locais, todos os campos do manifesto, CPU/GPU. -->
    <Window.Resources>
        <Style x:Key="Mm.Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Med.TextMuted}" />
            <Setter Property="Margin" Value="0,3,12,3" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="Mm.Value" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Med.Text}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="14">
        <!-- Rodapé: privacidade, dispositivo, status e ações -->
        <!-- Coluna dos botões em Auto: eles sempre cabem inteiros; os textos à esquerda quebram linha. -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical" Margin="0,0,16,0">
                <TextBlock Text="{Binding Privacy}" Foreground="{DynamicResource Med.TextMuted}" TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Executar modelos em:" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <RadioButton Content="GPU (DirectML)" IsChecked="{Binding UseGpu}" Margin="0,0,12,0" AutomationProperties.Name="Usar GPU" />
                    <RadioButton Content="Somente CPU" AutomationProperties.Name="Usar somente CPU">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                <Setter Property="IsChecked" Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UseGpu}" Value="False">
                                        <Setter Property="IsChecked" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                </WrapPanel>
                <TextBlock Text="{Binding Status}" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Baixar modelos…" Click="BaixarModelos_Click" Style="{DynamicResource Med.AccentButton}" Margin="0,0,8,0" Padding="12,4"
                        AutomationProperties.Name="Baixar modelos de IA" ToolTip="Ver os modelos disponíveis e instalar sem usar o terminal" />
                <Button Content="Instalar pacote…" Command="{Binding InstallCommand}" Margin="0,0,8,0" Padding="12,4" AutomationProperties.Name="Instalar pacote de modelo" />
                <Button Content="Verificar integridade" Command="{Binding VerifyCommand}" Margin="0,0,8,0" Padding="12,4" />
                <Button Content="Remover" Command="{Binding RemoveCommand}" Margin="0,0,8,0" Padding="12,4" AutomationProperties.Name="Remover modelo" />
                <Button Content="Fechar" IsCancel="True" Click="Fechar_Click" Padding="12,4" />
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Recursos e modelos instalados -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Recursos de IA" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Capabilities}" AutomationProperties.Name="Recursos de IA" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2,0,4" AutomationProperties.Name="{Binding Feature}">
                                <TextBlock Text="{Binding Feature}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Med.TextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Available}" Value="True">
                                                    <Setter Property="Foreground" Value="#4CAF50" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock DockPanel.Dock="Top" Text="Modelos instalados" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding MemorySummary}" Foreground="{DynamicResource Med.TextMuted}" Margin="0,6,0,0" />
                <ListBox ItemsSource="{Binding Models}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Modelos instalados"
                         Background="{DynamicResource Med.PanelAlt}" BorderThickness="0" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource Med.TextMuted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Detalhes do modelo selecionado: todos os campos do §8.3 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource Mm.Label}" Text="Identificador" />
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Mm.Value}" Text="{Binding Id, Mode=OneWay}" AutomationProperties.Name="Identificador" />
                        <TextBlock Grid.Row="1" Style="{StaticResource Mm.Label}" Text="Versão" />
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Mm.Value}" Text="{Binding Version, Mode=OneWay}" AutomationProperties.Name="Versão" />
                        <TextBlock Grid.Row="2" Style="{StaticResource Mm.Label}" Text="Fabricante/origem" />
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Mm.Value}" Text="{Binding Source, Mode=OneWay}" AutomationProperties.Name="Origem" />
                        <TextBlock Grid.Row="3" Style="{StaticResource Mm.Label}" Text="Finalidade" />
                        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Mm.Value}" Text="{Binding Purpose, Mode=OneWay}" AutomationProperties.Name="Finalidade" />
                        <TextBlock Grid.Row="4" Style="{StaticResource Mm.Label}" Text="Recurso" />
                        <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource Mm.Value}" Text="{Binding Capability, Mode=OneWay}" />
                        <TextBlock Grid.Row="5" Style="{StaticResource Mm.Label}" Text="Formato" />
                        <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource Mm.Value}" Text="{Binding Format, Mode=OneWay}" AutomationProperties.Name="Formato" />
                        <TextBlock Grid.Row="6" Style="{StaticResource Mm.Label}" Text="Tamanho" />
                        <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource Mm.Value}" Text="{Binding Size, Mode=OneWay}" AutomationProperties.Name="Tamanho" />
                        <TextBlock Grid.Row="7" Style="{StaticResource Mm.Label}" Text="Memória necessária" />
                        <StackPanel Grid.Row="7" Grid.Column="1">
                            <TextBox Style="{StaticResource Mm.Value}" Text="{Binding Memory, Mode=OneWay}" AutomationProperties.Name="Memória necessária" />
                            <TextBlock Text="{Binding MemoryCheck}" FontSize="11" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Med.TextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MemoryWarning}" Value="True">
                                                <Setter Property="Foreground" Value="#E8A33D" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Row="8" Style="{StaticResource Mm.Label}" Text="Compatível com CPU" />
                        <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource Mm.Value}" Text="{Binding Cpu, Mode=OneWay}" AutomationProperties.Name="Compatível com CPU" />
                        <TextBlock Grid.Row="9" Style="{StaticResource Mm.Label}" Text="Compatível com GPU" />
                        <TextBox Grid.Row="9" Grid.Column="1" Style="{StaticResource Mm.Value}" Text="{Binding Gpu, Mode=OneWay}" AutomationProperties.Name="Compatível com GPU" />
                        <TextBlock Grid.Row="10" Style="{StaticResource Mm.Label}" Text="Licença" />
                        <TextBox Grid.Row="10" Grid.Column="1" Style="{StaticResource Mm.Value}" Text="{Binding License, Mode=OneWay}" AutomationProperties.Name="Licença" />
                        <TextBlock Grid.Row="11" Style="{StaticResource Mm.Label}" Text="Hash (SHA-256)" />
                        <TextBox Grid.Row="11" Grid.Column="1" Style="{StaticResource Mm.Value}" Text="{Binding Hash, Mode=OneWay}" FontFamily="Consolas" AutomationProperties.Name="Hash" />
                        <TextBlock Grid.Row="12" Style="{StaticResource Mm.Label}" Text="Integridade" />
                        <TextBox Grid.Row="12" Grid.Column="1" Style="{StaticResource Mm.Value}" Text="{Binding Integrity, Mode=OneWay}" AutomationProperties.Name="Integridade" />
                        <TextBlock Grid.Row="13" Style="{StaticResource Mm.Label}" Text="Localização" />
                        <TextBox Grid.Row="13" Grid.Column="1" Style="{StaticResource Mm.Value}" Text="{Binding Location, Mode=OneWay}" AutomationProperties.Name="Localização" />
                        <TextBlock Grid.Row="14" Style="{StaticResource Mm.Label}" Text="Instalação" />
                        <TextBox Grid.Row="14" Grid.Column="1" Style="{StaticResource Mm.Value}" Text="{Binding Installation, Mode=OneWay}" AutomationProperties.Name="Instalação" />
                    </Grid>
                    <TextBlock Text="Documentação" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <TextBox Text="{Binding Documentation, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="260"
                             VerticalScrollBarVisibility="Auto" Background="{DynamicResource Med.PanelAlt}" Foreground="{DynamicResource Med.Text}"
                             AutomationProperties.Name="Documentação do modelo" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
