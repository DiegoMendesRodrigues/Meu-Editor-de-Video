<Window x:Class="MeuEditorDeVideo.App.Views.Dialogs.RenderQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fila de renderização"
        Width="760"
        Height="460"
        MinWidth="560"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Med.Background}"
        Foreground="{DynamicResource Med.Text}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Med.Border}" BorderThickness="0,1,0,0" Padding="12,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Fechar" IsCancel="True" Click="Fechar_Click" Padding="16,6"
                        AutomationProperties.Name="Fechar" />
                <Button Content="Limpar concluídas" Command="{Binding ClearFinishedCommand}" Padding="12,6" HorizontalAlignment="Left"
                        AutomationProperties.Name="Limpar concluídas" />
            </DockPanel>
        </Border>
        <Grid>
            <TextBlock Text="Nenhuma exportação na fila." Style="{StaticResource Med.MutedText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            <ListBox ItemsSource="{Binding Jobs}" AutomationProperties.Name="Exportações"
                     Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        <Setter Property="AutomationProperties.ItemStatus" Value="{Binding StatusText}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Med.Border}" BorderThickness="0,0,0,1" Padding="8,8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Med.MutedText}">
                                    <Run Text="{Binding Template, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Format, Mode=OneWay}" />
                                </TextBlock>
                                <ProgressBar Height="6" Margin="0,6,0,4" Maximum="100" Value="{Binding Percent}"
                                             AutomationProperties.Name="Progresso da exportação"
                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Style="{StaticResource Med.MutedText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Cancelar" Style="{StaticResource RowButton}" AutomationProperties.Name="Cancelar exportação"
                                            Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Retomar" Style="{StaticResource RowButton}" AutomationProperties.Name="Retomar exportação"
                                            Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Abrir" Style="{StaticResource RowButton}" AutomationProperties.Name="Abrir arquivo exportado"
                                            Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Mostrar na pasta" Style="{StaticResource RowButton}" AutomationProperties.Name="Mostrar na pasta"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Remover" Style="{StaticResource RowButton}" AutomationProperties.Name="Remover da fila"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
