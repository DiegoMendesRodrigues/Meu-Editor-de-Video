<Window x:Class="MeuEditorDeVideo.App.Views.Dialogs.MissingMediaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mídias não encontradas"
        Width="640"
        MinWidth="520"
        SizeToContent="Height"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Med.Background}"
        Foreground="{DynamicResource Med.Text}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Enquanto a busca está em andamento, todos os botões ficam desabilitados -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE7BA;"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="24"
                       Foreground="{DynamicResource Med.Danger}"
                       VerticalAlignment="Top"
                       Margin="0,2,12,0" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="Algumas mídias do projeto não foram encontradas"
                           Style="{StaticResource Med.SectionTitle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Med.MutedText}"
                           TextWrapping="Wrap"
                           Text="Localize os arquivos para que apareçam corretamente. Você pode continuar sem eles; os trechos ficarão marcados como ausentes." />
            </StackPanel>
        </Grid>

        <!-- Lista de mídias ausentes -->
        <ScrollViewer Grid.Row="1"
                      MaxHeight="320"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Med.PanelBorder}"
                                Padding="12,10"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Med.MutedText}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding OriginalPath}">
                                        <Run Text="{Binding KindLabel, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding OriginalPath, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Localizar…"
                                        AutomationProperties.Name="Localizar mídia ausente"
                                        VerticalAlignment="Center"
                                        Padding="12,4"
                                        Command="{Binding DataContext.LocateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Mensagem de status (oculta quando vazia) -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Med.MutedText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Progresso -->
        <ProgressBar Grid.Row="3"
                     Height="4"
                     Margin="0,0,0,12"
                     Foreground="{DynamicResource Med.Accent}"
                     IsIndeterminate="{Binding IsBusy}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                     AutomationProperties.Name="Procurando mídias" />

        <!-- Rodapé -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Procurar em pasta…"
                    AutomationProperties.Name="Procurar em pasta"
                    Command="{Binding SearchFolderCommand}"
                    Padding="16,8" />
            <Button Grid.Column="1"
                    Content="Continuar sem as mídias"
                    AutomationProperties.Name="Continuar sem as mídias"
                    Command="{Binding ContinueCommand}"
                    IsCancel="True"
                    HorizontalAlignment="Right"
                    Padding="16,8" />
        </Grid>
    </Grid>
</Window>
