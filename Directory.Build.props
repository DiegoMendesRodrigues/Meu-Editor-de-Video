<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <Company>Meu Editor de Vídeo</Company>
    <Product>Meu Editor de Vídeo</Product>
    <Copyright>Copyright © 2026 — Licenciado sob GPL-3.0-or-later</Copyright>
    <Version>1.4.0</Version>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- Sistema-alvo (windows, linux ou macos), usado para escolher pacotes com bibliotecas nativas diferentes por sistema.
       Vem do RuntimeIdentifier passado no build (dotnet publish -r linux-x64); sem ele, é o sistema em que o build roda.
       Também pode ser forçado com -p:MedPlataforma=linux (por exemplo, para conferir a restauração dos pacotes). -->
  <PropertyGroup Condition="'$(MedPlataforma)' == ''">
    <MedPlataforma Condition="$(RuntimeIdentifier.StartsWith('win'))">windows</MedPlataforma>
    <MedPlataforma Condition="$(RuntimeIdentifier.StartsWith('linux'))">linux</MedPlataforma>
    <MedPlataforma Condition="$(RuntimeIdentifier.StartsWith('osx'))">macos</MedPlataforma>
    <MedPlataforma Condition="'$(MedPlataforma)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">windows</MedPlataforma>
    <MedPlataforma Condition="'$(MedPlataforma)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux</MedPlataforma>
    <MedPlataforma Condition="'$(MedPlataforma)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">macos</MedPlataforma>
  </PropertyGroup>
</Project>
