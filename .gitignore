# Build
bin/
obj/
*.user
*.suo
.vs/
TestResults/
*.binlog
.idea/
*.DotSettings.user

# Arquivos do Windows
Thumbs.db
desktop.ini

# Dependências nativas baixadas por scripts/fetch-deps.ps1 (verificadas por hash)
/deps/

# Modelos de IA (distribuídos como pacotes .medmodel separados)
/resources/ai-models/**/*.onnx
/resources/ai-models/**/*.bin
*.medmodel

# Mídias de teste geradas
/tests/media-samples/

# Claude Code (configuração local pessoal)
.claude/settings.local.json

# Saídas do instalador (scripts/build-installer.ps1)
/artifacts/

# Site do produto (contém o arquivo de configuração com a senha do e-mail)
/website/

# Arquivos do macOS e do Linux
.DS_Store
._*
.AppleDouble
.directory
*~
*.swp

# Pacotes gerados fora de artifacts/ (os scripts de instalador e de pacote gravam em artifacts/)
*.deb
*.dmg
*.msi
*.msix

# Resultados de testes e cobertura (InstallerResults: logs e capturas de scripts/ci/testar-*)
/InstallerResults/
*.trx
*.coverage
coverage*/

# Claude Code: bloqueio de tarefas agendadas e cópias de trabalho (worktrees)
.claude/scheduled_tasks.lock
.claude/worktrees/

# Cópias de trabalho para simular outro sistema (ex.: Mac Intel) e arquivos temporários
/scratch/
