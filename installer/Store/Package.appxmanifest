<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifesto do pacote MSIX para a Microsoft Store.
  Os marcadores $...$ são preenchidos por scripts/build-msix.ps1 a partir de installer/Store/store.json
  (identidade reservada no Partner Center) e da versão em Directory.Build.props.
-->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">

  <Identity Name="$IdentityName$"
            Publisher="$Publisher$"
            Version="$Version$"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>$DisplayName$</DisplayName>
    <PublisherDisplayName>$PublisherDisplayName$</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
    <Description>Editor de vídeo com processamento 100% local, inclusive inteligência artificial.</Description>
  </Properties>

  <Dependencies>
    <!-- Somente Windows 11 (22000 ou superior), como o instalador MSI. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
    <!-- Runtime do Visual C++ (ONNX Runtime, OpenCV, Whisper): a Store instala automaticamente. -->
    <PackageDependency Name="Microsoft.VCLibs.140.00.UWPDesktop" MinVersion="14.0.30704.0"
                       Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="pt-BR" />
  </Resources>

  <Applications>
    <Application Id="MeuEditorDeVideo"
                 Executable="MeuEditorDeVideo.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="$DisplayName$"
                          Description="Editor de vídeo com IA local"
                          BackgroundColor="transparent"
                          Square150x150Logo="Images\Square150x150Logo.png"
                          Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png"
                         Square71x71Logo="Images\SmallTile.png"
                         Square310x310Logo="Images\LargeTile.png"
                         ShortName="Meu Editor" />
      </uap:VisualElements>

      <Extensions>
        <!-- Abrir arquivos .med com duplo clique: o Windows passa o caminho como argumento (StartupArguments). -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="meueditordevideo.projeto">
            <uap:DisplayName>Projeto do Meu Editor de Vídeo</uap:DisplayName>
            <uap:Logo>Images\FileLogo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="application/x-meu-editor-de-video">.med</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Só a ferramenta "Baixar modelos de IA" usa a rede, e apenas quando o usuário clica em Instalar. -->
    <Capability Name="internetClient" />
    <!-- Aplicativo Win32 (WPF) completo. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
